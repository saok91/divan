    "selfcheck:boundary": "tsx src/boundary-guard.selfcheck.ts"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@divan/db": "workspace:*",
    "@types/pg": "^8.15.4",
    "dotenv": "^17.4.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
