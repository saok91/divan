{
  "name": "@divan/app-settings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts",
    "./validate": "./src/validate.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "selfcheck": "tsx src/app-settings.selfcheck.ts && tsx src/boundary-guard.selfcheck.ts",
