// Prisma schema — identity projections (Story 1.4) + Person / Employment / DataElement (3.1–3.3)
// + compensation-facts isolated schema (3.4 / AD-3) + OrganizationalUnit hierarchy (3.5 / FR-9).
// Person is HR identity aggregate — distinct from HumanIdentity (login).
// Employment is a projection (AD-2), not event-store truth. Assignment / event-store = Epic 3.7+ / Epic 4.
// DataElement registry governs field enablement (FR-7) — values stay on Person columns for MVP approve set.
// CompensationFact lives in PostgreSQL schema "compensation" — owned by @divan/compensation-facts only.
// OrganizationalUnit (LE→BU→Dept→Team) is org master-data — NOT OrganizationalScope (authz population).
// Kernel event-store tables use raw SQL under packages/db/sql/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "compensation"]
}

/// MVP coarse roles — machine codes only (Story 1.4 / 1.5 consumers).
enum CoarseRole {
  hr_operator
  hr_admin
  manager
  audit_reviewer
  system_admin
  @@schema("public")
}

enum AccountStatus {
  active
  inactive
  @@schema("public")
}

/// Internal human identity projection — not an HR Person record.
/// Distinct aggregate from Person (Story 3.1); no FK either direction (AR-IDENTITY).
model HumanIdentity {
  id          String   @id @default(cuid())
  displayName String
  createdAt   DateTime @default(now())

  account InternalAccount?
  @@schema("public")
}

/// HR Person master-data projection (Story 3.1 / FR-5).
/// UUID PK; Personnel Code is the domain identifier (@unique).
/// Employment end must never cascade-delete Person (FR-5 — Restrict FK from Employment).
model Person {
  id            String    @id @default(uuid(7))
  /// Canonical Latin digits for uniqueness; accept Persian/Arabic-Indic on input.
  personnelCode String    @unique
  givenName     String
  familyName    String
  /// MVP mandatory contact (AR-DATA approve); format governed by Data Dictionary (Story 3.3).
  mobilePhone   String
  fatherName    String?
  birthDate     DateTime? @db.Date
  gender        String?
  nationality   String?
  /// Unique when present — PostgreSQL UNIQUE treats NULLs as distinct.
  nationalId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employments Employment[]
  @@schema("public")
}

/// Data Dictionary registry row (Story 3.3 / FR-7).
/// Governs which Person attributes may be collected/shown — not EAV value storage.
/// Values for MVP approve identity fields stay on Person columns (AD-2 projection).
model DataElement {
  /// Stable id (e.g. person.mobile_phone) — never Excel column titles.
  elementId       String   @id
  /// approve | later | reject (AR-DATA partial freeze).
  disposition     String
  /// May be true only when disposition=approve AND mandatory metadata complete.
  enabled         Boolean  @default(false)
  purpose         String?
  ownerSource     String?
  format          String?
  sensitivity     String?
  access          String?
  retention       String?
  export          String?
  audit           String?
  /// Maps to audit-envelope category when sensitive (e.g. identity.national_id).
  categoryId      String?
  freeTextPurpose String?
  lineage         String?
  /// Person column key when this element maps to a Person field (e.g. mobilePhone).
  personFieldKey  String?
  labelFa         String
  /// FR-55 foreshadow — full governed versioning UI later.
  registryVersion String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
  @@index([disposition])
  @@schema("public")
}

/// Employment period projection (Story 3.2 / FR-6). AD-2: not authoritative event truth.
/// Half-open [startDate, endDateExclusive); null end = unbounded open.
/// Non-overlap enforced in domain + PostgreSQL EXCLUDE (btree_gist) in migration SQL.
model Employment {
  id                String    @id @default(uuid(7))
  personId          String
  person            Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  /// Inclusive Effective interval start (date-only).
  startDate         DateTime  @db.Date
  /// Exclusive end (AR-TEMPORAL); null = still open / active unbounded.
  endDateExclusive  DateTime? @db.Date
  /// Lean attribute — exact collaboration codes owned by AR-DATA.
  collaborationType String?
  /// Only meaningful when the interval is closed.
  terminationReason String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([personId])
  @@schema("public")
}

/// Org-unit master-data hierarchy (Story 3.5 / FR-9). Adjacency list + unitType discriminant.
/// Shape: LEGAL_ENTITY → BUSINESS_UNIT → DEPARTMENT → TEAM. Not OrganizationalScope (authz).
/// Half-open [startDate, endDateExclusive); deactivate closes interval — never hard-deletes.
/// Primary Assignment Team membership = Story 3.7 + Epic 4 (no Employment FK here).
model OrganizationalUnit {
  id               String    @id @default(uuid(7))
  /// Stable domain code — Latin-normalized uniqueness; display may use Persian digits.
  code             String    @unique
  nameFa           String
  /// LEGAL_ENTITY | BUSINESS_UNIT | DEPARTMENT | TEAM
  unitType         String
  parentId         String?
  parent           OrganizationalUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         OrganizationalUnit[] @relation("OrgUnitHierarchy")
  /// Inclusive Effective interval start (date-only, Asia/Tehran).
  startDate        DateTime  @db.Date
  /// Exclusive end; null = open / currently unbounded.
  endDateExclusive DateTime? @db.Date
  /// Operational flag synced on activate/deactivate; as-of truth is the interval.
  active           Boolean   @default(true)
  /// Placeholder until authoritative temporal reorg process (Epic 4+).
  sourceEventId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([parentId])
  @@index([unitType])
  @@schema("public")
}

/// One internal account per human; one coarse role per account.
model InternalAccount {
  id                  String        @id @default(cuid())
  username            String        @unique
  /// Seeded accounts keep a hash; LDAP-linked accounts must persist null (never store directory passwords).
  passwordHash        String?
  /// Immutable directory identifier (Infra-approved attribute). Null for seeded-only rows.
  externalDirectoryId String?       @unique
  status              AccountStatus @default(active)
  coarseRole          CoarseRole
  humanIdentityId     String        @unique
  humanIdentity       HumanIdentity @relation(fields: [humanIdentityId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  /// Explicit entitlement bindings (Story 2.3) — coarseRole remains nav-only.
  organizationalScopes AccountOrganizationalScope[]
  accessRoles          AccountAccessRole[]

  /// Entitlement grant lifecycle (Story 2.4) — governs when bindings apply.
  grantsAsSubject   EntitlementGrant[] @relation("GrantSubject")
  grantsAsRequester EntitlementGrant[] @relation("GrantRequester")
  grantsAsApprover  EntitlementGrant[] @relation("GrantApprover")
  grantsAsPostUseReviewer EntitlementGrant[] @relation("GrantPostUseReviewer")
  @@schema("public")
}

/// Organizational Scope projection — Admin-managed; not LDAP group sync.
/// `code` aligns demo/policy tokens (e.g. org:selfcheck) with membership (Story 2.6).
model OrganizationalScope {
  id        String   @id @default(cuid())
  /// Stable policy/demo alias — unique when set; AR-ACCESS owns production codes.
  code      String?  @unique
  labelFa   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts AccountOrganizationalScope[]
  grants   EntitlementGrant[]
  @@schema("public")
}

/// Explicit envelope permission codes only — never implies coarse-role allows.
model PermissionSet {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Envelope permission codes (e.g. access.administration).
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles AccessRole[]
  @@schema("public")
}

/// Entitlement role — must reference exactly one PermissionSet (AC #2).
model AccessRole {
  id              String        @id @default(cuid())
  code            String        @unique
  labelFa         String
  permissionSetId String
  permissionSet   PermissionSet @relation(fields: [permissionSetId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  accounts AccountAccessRole[]
  grants   EntitlementGrant[]
  @@schema("public")
}

/// Grant class — sensitive/global/bulk/mass/break_glass/cross_time require independent approval (FR-46/47).
enum EntitlementGrantKind {
  sensitive
  global
  bulk
  mass_assignment
  standard
  role_create
  scope_create
  break_glass
  /// Bounded pre/post relationship history — not management-derived default (Story 2.6).
  cross_time_scope
  @@schema("public")
}

/// Post-use review for break-glass (Story 2.5). Non-break-glass stays not_required.
enum PostUseReviewStatus {
  pending
  completed
  not_required
  @@schema("public")
}

/// Lifecycle status: requested → approved → active → (expired|revoked|suspended).
/// rejected is a terminal waive/deny path from requested.
enum EntitlementGrantStatus {
  requested
  approved
  active
  expired
  revoked
  suspended
  rejected
  @@schema("public")
}

/// Entitlement grant projection (Story 2.4 + 2.5 break-glass). Evidence stays in event-store.
/// Effective bindings remain AccountAccessRole / AccountOrganizationalScope;
/// grants govern when those bindings are applied or withdrawn.
model EntitlementGrant {
  id                    String                 @id @default(cuid())
  subjectAccountId      String
  requesterAccountId    String
  approverAccountId     String?
  kind                  EntitlementGrantKind
  status                EntitlementGrantStatus @default(requested)
  accessRoleId          String?
  organizationalScopeId String?
  /// Pending create params for role_create / scope_create (no HR fields).
  createPayload         Json?
  startsAt              DateTime?
  expiresAt             DateTime?
  recertifyBy           DateTime?
  revokedAt             DateTime?
  revokeReason          String?
  correlationId         String?
  /// Break-glass: stable incident / ticket reference (required for kind=break_glass).
  incidentId            String?
  /// Break-glass: short attributable purpose — no HR field values.
  purpose               String?
  postUseReviewStatus   PostUseReviewStatus    @default(not_required)
  postUseReviewedAt     DateTime?
  postUseReviewerAccountId String?
  /// Exceptional co-approval — never implied by break-glass activation alone (default deny).
  exceptionalExportApproved              Boolean @default(false)
  exceptionalPermissionAdminApproved     Boolean @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  subject               InternalAccount        @relation("GrantSubject", fields: [subjectAccountId], references: [id], onDelete: Cascade)
  requester             InternalAccount        @relation("GrantRequester", fields: [requesterAccountId], references: [id], onDelete: Cascade)
  approver              InternalAccount?       @relation("GrantApprover", fields: [approverAccountId], references: [id], onDelete: SetNull)
  postUseReviewer       InternalAccount?       @relation("GrantPostUseReviewer", fields: [postUseReviewerAccountId], references: [id], onDelete: SetNull)
  accessRole            AccessRole?            @relation(fields: [accessRoleId], references: [id], onDelete: SetNull)
  organizationalScope   OrganizationalScope?   @relation(fields: [organizationalScopeId], references: [id], onDelete: SetNull)

  @@index([subjectAccountId, status])
  @@index([expiresAt])
  @@index([recertifyBy])
  @@index([approverAccountId])
  @@index([status])
  @@index([requesterAccountId])
  @@index([kind, status])
  @@index([incidentId])
  @@index([postUseReviewStatus, status])
  @@schema("public")
}

model AccountOrganizationalScope {
  accountId             String
  organizationalScopeId String
  account               InternalAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organizationalScope   OrganizationalScope @relation(fields: [organizationalScopeId], references: [id], onDelete: Cascade)

  @@id([accountId, organizationalScopeId])
  @@index([organizationalScopeId])
  @@schema("public")
}

model AccountAccessRole {
  accountId    String
  accessRoleId String
  account      InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessRole   AccessRole      @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)

  @@id([accountId, accessRoleId])
  @@index([accessRoleId])
  @@schema("public")
}

/// FR42 attribution substrate — success and failure attempts.
model AuthAttempt {
  id               String   @id @default(cuid())
  correlationId    String
  accountId        String?
  usernameAttempted String?
  outcome          String
  occurredAt       DateTime @default(now())

  @@index([correlationId])
  @@index([occurredAt])
  @@schema("public")
}

/// FR42 attribution substrate — deep-link / route denials (Story 1.5).
/// Thin identity schema only — not the Epic 2 audit-envelope kernel.
model AccessDenial {
  id            String   @id @default(cuid())
  correlationId String
  accountId     String
  coarseRole    String
  path          String
  outcome       String   @default("denied")
  occurredAt    DateTime @default(now())

  @@index([correlationId])
  @@index([occurredAt])
  @@schema("public")
}


/// Compensation / contractual fact projection (Story 3.4 / FR-8). AD-2: not event-store truth.
/// Lives in isolated schema `compensation` — only @divan/compensation-facts may access.
/// Half-open [startDate, endDateExclusive); null end = unbounded open.
/// Non-overlap per (personId, factKind) via domain + PostgreSQL EXCLUDE in migration SQL.
/// No payroll/tax/insurance/payment calculation columns or helpers.
model CompensationFact {
  id                       String    @id @default(uuid(7))
  personId                 String
  /// Optional Employment scope — Restrict; nullable until always known.
  employmentId             String?
  /// "compensation" | "contractual" — partitions overlap exclusion.
  factKind                 String
  startDate                DateTime  @db.Date
  endDateExclusive         DateTime? @db.Date
  /// Compensation attributes (dictionary-gated on write when enforce).
  /// Stored as decimal string — no payroll arithmetic in this module.
  amount                   String?
  components               Json?
  currency                 String?
  changeType               String?
  notes                    String?
  /// Contractual attributes (rich history; Employment.collaborationType stays lean).
  collaborationType        String?
  contractType             String?
  contractingEntity        String?
  insuringEntity           String?
  contractReference        String?
  contractStartDate        DateTime? @db.Date
  contractEndDateExclusive DateTime? @db.Date
  /// Provenance — null until Epic 4 Personnel Events (Story 4.8).
  sourceEventId            String?
  /// Registration/system time — distinct from Effective Date (FR-44 foreshadow).
  recordedAt               DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([personId, factKind])
  @@index([personId])
  @@schema("compensation")
}
