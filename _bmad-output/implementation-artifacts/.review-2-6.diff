diff --git a/packages/kernel/temporal-engine/src/date-only.ts b/packages/kernel/temporal-engine/src/date-only.ts
new file mode 100644
index 0000000..3b41a89
--- /dev/null
+++ b/packages/kernel/temporal-engine/src/date-only.ts
@@ -0,0 +1,115 @@
+/**
+ * Pure AR-TEMPORAL date helpers (Story 2.6).
+ * Date-only YYYY-MM-DD in Asia/Tehran calendar day semantics.
+ * No projection rebuild / event engine ΓÇö Epic 4 owns that.
+ */
+
+export const TEHRAN_TZ = "Asia/Tehran";
+
+const DATE_ONLY_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+/**
+ * Validate a date-only string. Rejects timestamps, timezone suffixes,
+ * and impossible calendar days. Fail-closed for authz callers.
+ */
+export function parseDateOnly(
+  raw: string | null | undefined,
+): { ok: true; value: string } | { ok: false; reason: string } {
+  if (raw === null || raw === undefined) {
+    return { ok: false, reason: "as_of_missing" };
+  }
+  const trimmed = raw.trim();
+  if (!trimmed) {
+    return { ok: false, reason: "as_of_empty" };
+  }
+  // Reject timestamps / time / timezone fragments
+  if (/[T\s]|Z|[+-]\d{2}:?\d{2}$/i.test(trimmed) || trimmed.includes(":")) {
+    return { ok: false, reason: "as_of_ambiguous_timestamp" };
+  }
+  const m = DATE_ONLY_RE.exec(trimmed);
+  if (!m) {
+    return { ok: false, reason: "as_of_invalid_format" };
+  }
+  const y = Number(m[1]);
+  const mo = Number(m[2]);
+  const d = Number(m[3]);
+  if (mo < 1 || mo > 12 || d < 1 || d > 31) {
+    return { ok: false, reason: "as_of_invalid_calendar" };
+  }
+  // Construct UTC noon probe to avoid DST edge on pure calendar validity
+  const probe = new Date(Date.UTC(y, mo - 1, d));
+  if (
+    probe.getUTCFullYear() !== y ||
+    probe.getUTCMonth() !== mo - 1 ||
+    probe.getUTCDate() !== d
+  ) {
+    return { ok: false, reason: "as_of_invalid_calendar" };
+  }
+  return { ok: true, value: trimmed };
+}
+
+/** Today's calendar date in Asia/Tehran as YYYY-MM-DD. */
+export function todayDateOnlyTehran(now: Date = new Date()): string {
+  const parts = new Intl.DateTimeFormat("en-CA", {
+    timeZone: TEHRAN_TZ,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(now);
+  const y = parts.find((p) => p.type === "year")?.value;
+  const m = parts.find((p) => p.type === "month")?.value;
+  const d = parts.find((p) => p.type === "day")?.value;
+  if (!y || !m || !d) {
+    // Fail-closed callers should treat empty as invalid; provide UTC fallback only for labeling.
+    return now.toISOString().slice(0, 10);
+  }
+  return `${y}-${m}-${d}`;
+}
+
+/**
+ * True when `asOf` is strictly after today's Tehran date (future ΓåÆ planned, not Effective).
+ */
+export function isFutureAsOf(
+  asOfDate: string,
+  now: Date = new Date(),
+): boolean {
+  const parsed = parseDateOnly(asOfDate);
+  if (!parsed.ok) return false;
+  return parsed.value > todayDateOnlyTehran(now);
+}
+
+/**
+ * Half-open interval [start, end): end exclusive.
+ * Missing end ΓåÆ unbounded future; missing start ΓåÆ unbounded past.
+ */
+export function dateOnlyInInterval(
+  date: string,
+  start: string | null | undefined,
+  endExclusive: string | null | undefined,
+): boolean {
+  const d = parseDateOnly(date);
+  if (!d.ok) return false;
+  if (start) {
+    const s = parseDateOnly(start);
+    if (!s.ok || d.value < s.value) return false;
+  }
+  if (endExclusive) {
+    const e = parseDateOnly(endExclusive);
+    if (!e.ok || d.value >= e.value) return false;
+  }
+  return true;
+}
+
+/** Overlap of two half-open date-only intervals. */
+export function intervalsOverlap(
+  aStart: string | null | undefined,
+  aEndExclusive: string | null | undefined,
+  bStart: string | null | undefined,
+  bEndExclusive: string | null | undefined,
+): boolean {
+  const aS = aStart ?? "0001-01-01";
+  const aE = aEndExclusive ?? "9999-12-31";
+  const bS = bStart ?? "0001-01-01";
+  const bE = bEndExclusive ?? "9999-12-31";
+  return aS < bE && bS < aE;
+}


diff --git a/packages/modules/identity-access/src/population-authz.ts b/packages/modules/identity-access/src/population-authz.ts
new file mode 100644
index 0000000..6087465
--- /dev/null
+++ b/packages/modules/identity-access/src/population-authz.ts
@@ -0,0 +1,355 @@
+/**
+ * PopulationPort ΓÇö temporal + cross-boundary intersection (Story 2.6 / FR-47).
+ *
+ * Fixture-backed until Epic 3/4 Person / Assignment projections exist.
+ * Callers: after envelope allow (or as part of authorize path for demos).
+ * Empty intersection ΓåÆ safe empty / omit ΓÇö never invent out-of-scope rows.
+ *
+ * Management-derived default: only facts inside the authorized relationship
+ * interval. Pre-scope (current manager) and post-scope (former manager)
+ * require an active cross_time_scope grant ΓÇö never silent widen.
+ */
+
+import {
+  dateOnlyInInterval,
+  parseDateOnly,
+  todayDateOnlyTehran,
+} from "@divan/temporal-engine";
+
+export type RetrievalChannel =
+  | "profile"
+  | "timeline"
+  | "search"
+  | "count"
+  | "dashboard"
+  | "report"
+  | "export"
+  | "audit";
+
+export type PopulationSubject = {
+  id: string;
+  /** Scope codes this subject belongs to (fixture). */
+  scopeCodes: string[];
+};
+
+export type ManagementRelationship = {
+  managerAccountId: string;
+  subjectId: string;
+  /** Inclusive start YYYY-MM-DD. */
+  validFrom: string;
+  /** Exclusive end YYYY-MM-DD; null = still current. */
+  validToExclusive: string | null;
+};
+
+export type CrossTimeGrantFixture = {
+  accountId: string;
+  purpose: string;
+  category: string;
+  /** Inclusive start. */
+  validFrom: string;
+  /** Exclusive end. */
+  validToExclusive: string;
+  /** Subject ids covered by this bounded grant. */
+  subjectIds: string[];
+  active: boolean;
+};
+
+export type PopulationFact = {
+  subjectId: string;
+  /** Fact validity date (date-only). */
+  asOf: string;
+  kind: string;
+};
+
+export type PopulationPortInput = {
+  actorAccountId: string;
+  actorScopeCodes: string[];
+  /** Evaluation date ΓÇö current mode uses today Tehran. */
+  asOfDate: string;
+  channel: RetrievalChannel;
+  /** Optional object/subject id filters (drill-down / profile). */
+  objectIds?: string[];
+  /**
+   * When set, intersect against these facts (timeline). Otherwise use
+   * subject membership only.
+   */
+  facts?: PopulationFact[];
+  /**
+   * Unreconciled / stale membership flag ΓÇö fail closed when true.
+   */
+  unreconciled?: boolean;
+  /**
+   * Missing port dependency simulation ΓÇö fail closed when true.
+   */
+  portUnavailable?: boolean;
+};
+
+export type PopulationPortDeny = {
+  ok: false;
+  reason: string;
+};
+
+export type PopulationPortAllow = {
+  ok: true;
+  /** Authorized subject ids ΓÇö intersection only. */
+  subjectIds: string[];
+  /** When facts were requested, authorized fact keys (subjectId|asOf|kind). */
+  factKeys: string[];
+};
+
+export type PopulationPortResult = PopulationPortAllow | PopulationPortDeny;
+
+export type PopulationFixtureRegistry = {
+  subjects: PopulationSubject[];
+  relationships: ManagementRelationship[];
+  crossTimeGrants: CrossTimeGrantFixture[];
+  facts: PopulationFact[];
+};
+
+/**
+ * Demo fixture population ΓÇö proves FR-47 without Person tables.
+ * Scope A Γê⌐ B subjects; management intervals; cross-time grants.
+ */
+export const DEMO_POPULATION_FIXTURES: PopulationFixtureRegistry = {
+  subjects: [
+    { id: "person:a1", scopeCodes: ["org:fixture-a"] },
+    { id: "person:a2", scopeCodes: ["org:fixture-a"] },
+    { id: "person:b1", scopeCodes: ["org:fixture-b"] },
+    { id: "person:ab", scopeCodes: ["org:fixture-a", "org:fixture-b"] },
+    { id: "person:mgr-sub", scopeCodes: ["org:fixture-a"] },
+  ],
+  relationships: [
+    {
+      // Current manager for person:mgr-sub from 2024-01-01 (open-ended)
+      managerAccountId: "account:manager-current",
+      subjectId: "person:mgr-sub",
+      validFrom: "2024-01-01",
+      validToExclusive: null,
+    },
+    {
+      // Former manager ΓÇö relationship ended 2023-06-01 (exclusive)
+      managerAccountId: "account:manager-former",
+      subjectId: "person:mgr-sub",
+      validFrom: "2020-01-01",
+      validToExclusive: "2023-06-01",
+    },
+  ],
+  crossTimeGrants: [
+    {
+      accountId: "account:manager-current",
+      purpose: "pre_scope_history_review",
+      category: "demo.non_hr",
+      validFrom: "2023-01-01",
+      validToExclusive: "2024-01-01",
+      subjectIds: ["person:mgr-sub"],
+      active: true,
+    },
+    {
+      accountId: "account:manager-former",
+      purpose: "post_scope_audit_slice",
+      category: "demo.non_hr",
+      validFrom: "2023-06-01",
+      validToExclusive: "2023-12-01",
+      subjectIds: ["person:mgr-sub"],
+      active: true,
+    },
+  ],
+  facts: [
+    { subjectId: "person:mgr-sub", asOf: "2023-03-15", kind: "assignment" },
+    { subjectId: "person:mgr-sub", asOf: "2024-06-01", kind: "assignment" },
+    { subjectId: "person:mgr-sub", asOf: "2023-09-01", kind: "assignment" },
+  ],
+};
+
+let activeRegistry: PopulationFixtureRegistry = DEMO_POPULATION_FIXTURES;
+let portEnabled = true;
+
+export function getPopulationFixtureRegistry(): PopulationFixtureRegistry {
+  return activeRegistry;
+}
+
+/** Test/selfcheck hook. Pass null to restore demo fixtures. */
+export function setPopulationFixtureRegistryForTests(
+  registry: PopulationFixtureRegistry | null,
+): void {
+  activeRegistry = registry ?? DEMO_POPULATION_FIXTURES;
+}
+
+export function setPopulationPortEnabledForTests(enabled: boolean): void {
+  portEnabled = enabled;
+}
+
+function factKey(f: PopulationFact): string {
+  return `${f.subjectId}|${f.asOf}|${f.kind}`;
+}
+
+function subjectInActorScopes(
+  subject: PopulationSubject,
+  actorScopeCodes: string[],
+): boolean {
+  return subject.scopeCodes.some((c) => actorScopeCodes.includes(c));
+}
+
+function activeCrossTimeFor(
+  accountId: string,
+  subjectId: string,
+  asOfDate: string,
+  registry: PopulationFixtureRegistry,
+): boolean {
+  return registry.crossTimeGrants.some(
+    (g) =>
+      g.active &&
+      g.accountId === accountId &&
+      g.subjectIds.includes(subjectId) &&
+      dateOnlyInInterval(asOfDate, g.validFrom, g.validToExclusive),
+  );
+}
+
+function managementCovers(
+  accountId: string,
+  subjectId: string,
+  asOfDate: string,
+  registry: PopulationFixtureRegistry,
+): boolean {
+  return registry.relationships.some(
+    (r) =>
+      r.managerAccountId === accountId &&
+      r.subjectId === subjectId &&
+      dateOnlyInInterval(asOfDate, r.validFrom, r.validToExclusive),
+  );
+}
+
+/**
+ * Intersect authorized population for a retrieval channel.
+ * Fail-closed on unreconciled / missing port / invalid as-of.
+ */
+export function intersectPopulation(
+  input: PopulationPortInput,
+  registry: PopulationFixtureRegistry = activeRegistry,
+): PopulationPortResult {
+  if (!portEnabled || input.portUnavailable) {
+    return { ok: false, reason: "population_port_unavailable" };
+  }
+  if (input.unreconciled) {
+    return { ok: false, reason: "membership_unreconciled" };
+  }
+
+  const asOfParsed = parseDateOnly(input.asOfDate);
+  if (!asOfParsed.ok) {
+    return { ok: false, reason: asOfParsed.reason };
+  }
+  const asOf = asOfParsed.value;
+
+  if (!input.actorScopeCodes.length) {
+    return { ok: false, reason: "scope_membership_missing" };
+  }
+
+  const scopedSubjects = registry.subjects.filter((s) =>
+    subjectInActorScopes(s, input.actorScopeCodes),
+  );
+
+  let candidateIds = new Set(scopedSubjects.map((s) => s.id));
+
+  if (input.objectIds?.length) {
+    const wanted = new Set(input.objectIds);
+    candidateIds = new Set([...candidateIds].filter((id) => wanted.has(id)));
+  }
+
+  // Management-derived channels: further narrow by relationship interval
+  // (or explicit cross-time grant). Non-manager actors keep scope intersection.
+  const isManagerActor =
+    input.actorAccountId.startsWith("account:manager-") ||
+    registry.relationships.some(
+      (r) => r.managerAccountId === input.actorAccountId,
+    );
+
+  const facts =
+    input.facts ??
+    (input.channel === "timeline" || input.channel === "profile"
+      ? registry.facts.filter((f) => candidateIds.has(f.subjectId))
+      : []);
+
+  if (isManagerActor && facts.length > 0) {
+    const authorizedFacts: PopulationFact[] = [];
+    for (const f of facts) {
+      if (!candidateIds.has(f.subjectId)) continue;
+      const inRel = managementCovers(
+        input.actorAccountId,
+        f.subjectId,
+        f.asOf,
+        registry,
+      );
+      const viaGrant = activeCrossTimeFor(
+        input.actorAccountId,
+        f.subjectId,
+        f.asOf,
+        registry,
+      );
+      if (inRel || viaGrant) {
+        authorizedFacts.push(f);
+      }
+    }
+    const subjectIds = [...new Set(authorizedFacts.map((f) => f.subjectId))];
+    return {
+      ok: true,
+      subjectIds,
+      factKeys: authorizedFacts.map(factKey),
+    };
+  }
+
+  if (isManagerActor && (input.channel === "profile" || input.objectIds?.length)) {
+    // Subject-level check at evaluation asOf
+    const allowed: string[] = [];
+    for (const id of candidateIds) {
+      const inRel = managementCovers(
+        input.actorAccountId,
+        id,
+        asOf,
+        registry,
+      );
+      const viaGrant = activeCrossTimeFor(
+        input.actorAccountId,
+        id,
+        asOf,
+        registry,
+      );
+      if (inRel || viaGrant) {
+        allowed.push(id);
+      }
+    }
+    return { ok: true, subjectIds: allowed, factKeys: [] };
+  }
+
+  // Aggregate channels (search/count/dashboard/report/export/audit):
+  // intersection of scope membership only ΓÇö omit out-of-scope, never mask as 0.
+  return {
+    ok: true,
+    subjectIds: [...candidateIds],
+    factKeys: [],
+  };
+}
+
+/**
+ * Drill-down MUST reuse the same authorized id set as the parent aggregate.
+ * Documented choice: recompute identically with the same inputs (deterministic).
+ */
+export function drillDownPopulation(
+  parent: PopulationPortInput,
+  objectId: string,
+  registry: PopulationFixtureRegistry = activeRegistry,
+): PopulationPortResult {
+  const parentResult = intersectPopulation(parent, registry);
+  if (!parentResult.ok) return parentResult;
+  if (!parentResult.subjectIds.includes(objectId)) {
+    return { ok: true, subjectIds: [], factKeys: [] };
+  }
+  return intersectPopulation(
+    { ...parent, objectIds: [objectId] },
+    registry,
+  );
+}
+
+/** Convenience: current-mode as-of = today Tehran. */
+export function currentAsOfDate(now: Date = new Date()): string {
+  return todayDateOnlyTehran(now);
+}


