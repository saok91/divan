@@ -0,0 +1,123 @@
+"use client";
+
+import * as React from "react";
+import { useRouter } from "next/navigation";
+import { useSession } from "next-auth/react";
+
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { operationalCopy } from "@/lib/operational-copy";
+import { usePlatformStatus } from "@/components/platform-status-provider";
+
+/**
+ * Mid-session authz change modal (Story 2.6 AC #4 / EXPERIENCE).
+ * Exact title: ┬½╪»╪│╪¬╪▒╪│█î ╪┤┘à╪º ╪¬╪║█î█î╪▒ ┌⌐╪▒╪».┬╗
+ * Required acknowledgement ΓÇö Esc does not dismiss (blocking).
+ * Demo draft stand-in for Epic 4 Draft forms.
+ */
+export function AuthzChangedModal({
+  landingPath,
+}: {
+  /** Role safe landing after ack. */
+  landingPath: string;
+}) {
+  const router = useRouter();
+  const { update } = useSession();
+  const {
+    authzChanged,
+    clearAuthzChanged,
+    demoDraftOpen,
+    setDemoDraftOpen,
+    isFinalizeBlockedByAuthzChange,
+  } = usePlatformStatus();
+
+  const open = authzChanged;
+  const titleId = "authz-changed-title";
+  const descId = "authz-changed-desc";
+
+  async function acknowledgeAndRedirect() {
+    setDemoDraftOpen(false);
+    clearAuthzChanged();
+    // Refresh JWT fingerprint to current bindings, then safe landing.
+    await update();
+    router.replace(landingPath);
+    router.refresh();
+  }
+
+  return (
+    <Dialog open={open} modal>
+      <DialogContent
+        showCloseButton={false}
+        aria-labelledby={titleId}
+        aria-describedby={descId}
+        onEscapeKeyDown={(e) => e.preventDefault()}
+        onPointerDownOutside={(e) => e.preventDefault()}
+        onInteractOutside={(e) => e.preventDefault()}
+        className="sm:max-w-md"
+      >
+        <DialogHeader>
+          <DialogTitle id={titleId}>{operationalCopy.scopeRevoked}</DialogTitle>
+          <DialogDescription id={descId} className="sr-only">
+            {operationalCopy.scopeRevoked}
+          </DialogDescription>
+        </DialogHeader>
+
+        <div
+          role="status"
+          aria-live="assertive"
+          className="text-sm text-foreground"
+        >
+          {demoDraftOpen
+            ? operationalCopy.authzChangedDraftHint
+            : operationalCopy.authzChangedFinalizeBlocked}
+        </div>
+
+        {isFinalizeBlockedByAuthzChange ? (
+          <p className="text-sm text-muted-foreground">
+            {operationalCopy.authzChangedFinalizeBlocked}
+          </p>
+        ) : null}
+
+        <DialogFooter className="gap-2 sm:justify-start">
+          {demoDraftOpen ? (
+            <>
+              <Button
+                type="button"
+                variant="secondary"
+                onClick={() => {
+                  void acknowledgeAndRedirect();
+                }}
+              >
+                {operationalCopy.authzChangedSaveDraft}
+              </Button>
+              <Button
+                type="button"
+                variant="outline"
+                onClick={() => {
+                  void acknowledgeAndRedirect();
+                }}
+              >
+                {operationalCopy.authzChangedDiscard}
+              </Button>
+            </>
+          ) : (
+            <Button
+              type="button"
+              variant="primary"
+              onClick={() => void acknowledgeAndRedirect()}
+            >
+              {operationalCopy.authzChangedAcknowledge}
+            </Button>
+          )}
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}


