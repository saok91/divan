@@ -0,0 +1,159 @@
+-- Story 4.1: FR-14 attributable business event columns on kernel_events.
+-- Idempotent ALTER — do not edit applied 001/002 history.
+-- Business rows carry Person / Effective Date / registration / status / evidence.
+-- Access rows leave business columns NULL; access result CHECK unchanged.
+
+ALTER TABLE kernel_events
+  ADD COLUMN IF NOT EXISTS event_type TEXT,
+  ADD COLUMN IF NOT EXISTS person_id UUID,
+  ADD COLUMN IF NOT EXISTS employment_id UUID,
+  ADD COLUMN IF NOT EXISTS effective_date DATE,
+  ADD COLUMN IF NOT EXISTS registered_at TIMESTAMPTZ,
+  ADD COLUMN IF NOT EXISTS registered_by TEXT,
+  ADD COLUMN IF NOT EXISTS finalized_at TIMESTAMPTZ,
+  ADD COLUMN IF NOT EXISTS finalized_by TEXT,
+  ADD COLUMN IF NOT EXISTS status TEXT,
+  ADD COLUMN IF NOT EXISTS reference_code TEXT,
+  ADD COLUMN IF NOT EXISTS provenance JSONB NOT NULL DEFAULT '{}'::jsonb,
+  ADD COLUMN IF NOT EXISTS before_evidence JSONB,
+  ADD COLUMN IF NOT EXISTS after_evidence JSONB,
+  -- Chain foreshadow for Story 4.3 (no product writers in 4.1)
+  ADD COLUMN IF NOT EXISTS corrects_event_id UUID,
+  ADD COLUMN IF NOT EXISTS cancels_event_id UUID,
+  ADD COLUMN IF NOT EXISTS reverses_event_id UUID,
+  ADD COLUMN IF NOT EXISTS supersedes_event_id UUID;
+
+COMMENT ON COLUMN kernel_events.event_type IS
+  'Personnel Event type (PascalCase past-tense). SoT for business type; required when event_class=business.';
+COMMENT ON COLUMN kernel_events.person_id IS
+  'Target Person UUID (application-level ref; no FK to Prisma Person in 4.1).';
+COMMENT ON COLUMN kernel_events.employment_id IS
+  'Applicable Employment UUID; NULL when Draft/Start has not bound Employment yet.';
+COMMENT ON COLUMN kernel_events.effective_date IS
+  'Business Effective Date (DATE only). Distinct from registered_at / finalized_at timestamptz.';
+COMMENT ON COLUMN kernel_events.registered_at IS
+  'Registration clock (timestamptz). Not Effective Date.';
+COMMENT ON COLUMN kernel_events.registered_by IS
+  'Registration actor InternalAccount id (TEXT cuid; aligns with actor_account_id).';
+COMMENT ON COLUMN kernel_events.finalized_at IS
+  'Finalization clock (timestamptz); NULL until Story 4.2 finalize.';
+COMMENT ON COLUMN kernel_events.finalized_by IS
+  'Finalization actor account id; NULL until Story 4.2.';
+COMMENT ON COLUMN kernel_events.status IS
+  'Lifecycle token: Draft | Scheduled | Effective | Cancelled | Reversed (transitions owned by 4.2/4.3).';
+COMMENT ON COLUMN kernel_events.reference_code IS
+  'Optional external/reference id (reason column remains separate).';
+COMMENT ON COLUMN kernel_events.provenance IS
+  'Source/import metadata JSON — no sensitive field values.';
+COMMENT ON COLUMN kernel_events.before_evidence IS
+  'Authorized reconstruction refs only — never compensation amounts / national ID.';
+COMMENT ON COLUMN kernel_events.after_evidence IS
+  'Authorized reconstruction refs only — never compensation amounts / national ID.';
+COMMENT ON COLUMN kernel_events.corrects_event_id IS
+  'Foreshadow Correction chain (4.3); nullable; no writer in 4.1.';
+COMMENT ON COLUMN kernel_events.cancels_event_id IS
+  'Foreshadow Cancel chain (4.3); nullable; no writer in 4.1.';
+COMMENT ON COLUMN kernel_events.reverses_event_id IS
+  'Foreshadow Reverse chain (4.3); nullable; no writer in 4.1.';
+COMMENT ON COLUMN kernel_events.supersedes_event_id IS
+  'Foreshadow supersede chain (4.3); nullable; no writer in 4.1.';
+
+-- Provisional status token set (transitions owned by 4.2/4.3).
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'kernel_events_status_token_chk'
+  ) THEN
+    ALTER TABLE kernel_events
+      ADD CONSTRAINT kernel_events_status_token_chk CHECK (
+        status IS NULL
+        OR status IN ('Draft', 'Scheduled', 'Effective', 'Cancelled', 'Reversed')
+      );
+  END IF;
+END $$;
+
+-- Business rows require FR-14 attributable fields.
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'kernel_events_business_required_chk'
+  ) THEN
+    ALTER TABLE kernel_events
+      ADD CONSTRAINT kernel_events_business_required_chk CHECK (
+        event_class <> 'business'
+        OR (
+          event_type IS NOT NULL
+          AND person_id IS NOT NULL
+          AND effective_date IS NOT NULL
+          AND status IS NOT NULL
+          AND registered_at IS NOT NULL
+          AND registered_by IS NOT NULL
+        )
+      );
+  END IF;
+END $$;
+
+-- Access-only result field must stay NULL on business rows.
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'kernel_events_business_result_null_chk'
+  ) THEN
+    ALTER TABLE kernel_events
+      ADD CONSTRAINT kernel_events_business_result_null_chk CHECK (
+        event_class <> 'business' OR result IS NULL
+      );
+  END IF;
+END $$;
+
+-- Access rows keep business-required columns NULL (access CHECK on result unchanged).
+DO $$
+BEGIN
+  IF NOT EXISTS (
+    SELECT 1 FROM pg_constraint WHERE conname = 'kernel_events_access_business_null_chk'
+  ) THEN
+    ALTER TABLE kernel_events
+      ADD CONSTRAINT kernel_events_access_business_null_chk CHECK (
+        event_class <> 'access'
+        OR (
+          event_type IS NULL
+          AND person_id IS NULL
+          AND effective_date IS NULL
+          AND status IS NULL
+          AND registered_at IS NULL
+          AND registered_by IS NULL
+        )
+      );
+  END IF;
+END $$;
+
+CREATE INDEX IF NOT EXISTS kernel_events_class_effective_date_idx
+  ON kernel_events (event_class, effective_date);
+
+CREATE INDEX IF NOT EXISTS kernel_events_person_effective_date_idx
+  ON kernel_events (person_id, effective_date);
+
+CREATE INDEX IF NOT EXISTS kernel_events_employment_id_idx
+  ON kernel_events (employment_id);
+
+-- Append-only hardening: block UPDATE/DELETE even for lab superusers.
+CREATE OR REPLACE FUNCTION kernel_events_forbid_mutation()
+RETURNS trigger
+LANGUAGE plpgsql
+AS $$
+BEGIN
+  RAISE EXCEPTION 'kernel_events is append-only: % not allowed', TG_OP
+    USING ERRCODE = 'integrity_constraint_violation';
+END;
+$$;
+
+DROP TRIGGER IF EXISTS kernel_events_append_only_trg ON kernel_events;
+CREATE TRIGGER kernel_events_append_only_trg
+  BEFORE UPDATE OR DELETE ON kernel_events
+  FOR EACH ROW
+  EXECUTE PROCEDURE kernel_events_forbid_mutation();
+
+-- REVOKE left commented — app role model unclear in lab (often table owner / superuser).
+-- When a non-owner app role exists:
+--   REVOKE UPDATE, DELETE ON kernel_events FROM PUBLIC;
+--   REVOKE UPDATE, DELETE ON kernel_events FROM <app_role>;
diff --git a/packages/kernel/event-store/src/business-event.ts b/packages/kernel/event-store/src/business-event.ts
new file mode 100644
index 0000000..d29d2e6
--- /dev/null
+++ b/packages/kernel/event-store/src/business-event.ts
@@ -0,0 +1,249 @@
+import { randomUUID } from "node:crypto";
+
+import { parseDateOnly } from "@divan/temporal-engine";
+import type { Pool, PoolClient } from "pg";
+
+type PgQueryable = Pick<Pool, "query"> | Pick<PoolClient, "query">;
+
+/** Provisional lifecycle tokens — transitions owned by Stories 4.2 / 4.3. */
+export type BusinessEventStatus =
+  | "Draft"
+  | "Scheduled"
+  | "Effective"
+  | "Cancelled"
+  | "Reversed";
+
+/**
+ * Personnel Event type names: PascalCase, past-tense convention
+ * (e.g. `TransferRecorded`, `EmploymentStarted`). Application enforces
+ * PascalCase shape; past-tense is documented convention for authors.
+ */
+const EVENT_TYPE_PASCAL_RE = /^[A-Z][A-Za-z0-9]*$/;
+
+/** Obvious sensitive keys — fail closed rather than store. */
+const SENSITIVE_EVIDENCE_KEYS = new Set([
+  "amount",
+  "compensation",
+  "salary",
+  "baseSalary",
+  "base_salary",
+  "nationalId",
+  "national_id",
+  "ssn",
+  "iban",
+  "bankAccount",
+  "bank_account",
+  "accountNumber",
+  "account_number",
+  "password",
+  "secret",
+  "token",
+  "religion",
+  "health",
+]);
+
+export type AppendBusinessEventInput = {
+  correlationId: string;
+  /** PascalCase past-tense Personnel Event type (SoT in `event_type` column). */
+  eventType: string;
+  personId: string;
+  /**
+   * Applicable Employment. Nullable when Draft / Start has not bound
+   * Employment yet (FR-14); set once Employment is assigned.
+   */
+  employmentId?: string | null;
+  /** Business Effective Date as YYYY-MM-DD (DATE column — not timestamptz). */
+  effectiveDate: string;
+  /** Registration actor InternalAccount id (TEXT cuid). Dual-written to `actor_account_id`. */
+  registeredBy: string;
+  /** Registration clock; defaults to now. Mapped to `registered_at` and `occurred_at`. */
+  registeredAt?: Date;
+  /** Defaults to `Draft` for scaffolding inserts (product transitions = 4.2+). */
+  status?: BusinessEventStatus;
+  reason?: string;
+  referenceCode?: string;
+  provenance?: Record<string, unknown>;
+  /** Structural refs / codes only — never sensitive field values. */
+  beforeEvidence?: Record<string, unknown> | null;
+  afterEvidence?: Record<string, unknown> | null;
+  /** Allowed for column-role selfcheck; product finalize = Story 4.2. */
+  finalizedBy?: string | null;
+  finalizedAt?: Date | null;
+  correctsEventId?: string | null;
+  cancelsEventId?: string | null;
+  reversesEventId?: string | null;
+  supersedesEventId?: string | null;
+  scope?: Record<string, unknown>;
+  /** Non-sensitive structural payload only. */
+  payload?: Record<string, unknown>;
+};
+
+export type AppendBusinessEventResult = {
+  id: string;
+};
+
+export class BusinessEventValidationError extends Error {
+  readonly code: string;
+
+  constructor(code: string, message: string) {
+    super(message);
+    this.name = "BusinessEventValidationError";
+    this.code = code;
+  }
+}
+
+export function assertValidBusinessEventType(eventType: string): void {
+  if (typeof eventType !== "string" || !eventType.trim()) {
+    throw new BusinessEventValidationError(
+      "invalid_event_type",
+      "eventType is required (PascalCase past-tense, e.g. TransferRecorded)",
+    );
+  }
+  const trimmed = eventType.trim();
+  if (!EVENT_TYPE_PASCAL_RE.test(trimmed)) {
+    throw new BusinessEventValidationError(
+      "invalid_event_type",
+      `eventType must be PascalCase past-tense (rejected: ${JSON.stringify(trimmed)})`,
+    );
+  }
+}
+
+/**
+ * Reject objects that embed known sensitive keys (fail-closed).
+ * Evidence / provenance hold refs and codes only — never amounts or national IDs.
+ */
+export function assertNoSensitiveEvidence(
+  label: string,
+  value: Record<string, unknown> | null | undefined,
+): void {
+  if (value == null) return;
+  walkRejectSensitive(label, value, "");
+}
+
+function walkRejectSensitive(
+  label: string,
+  value: unknown,
+  path: string,
+): void {
+  if (value == null || typeof value !== "object") return;
+  if (Array.isArray(value)) {
+    value.forEach((item, i) =>
+      walkRejectSensitive(label, item, `${path}[${i}]`),
+    );
+    return;
+  }
+  for (const [key, child] of Object.entries(value as Record<string, unknown>)) {
+    const next = path ? `${path}.${key}` : key;
+    if (SENSITIVE_EVIDENCE_KEYS.has(key)) {
+      throw new BusinessEventValidationError(
+        "sensitive_evidence_forbidden",
+        `${label} must not include sensitive key ${JSON.stringify(key)} at ${next}`,
+      );
+    }
+    walkRejectSensitive(label, child, next);
+  }
+}
+
+/**
+ * Append an `event_class=business` Personnel Event row.
+ * Append-only — there is no updateBusinessEvent / deleteBusinessEvent.
+ */
+export async function appendBusinessEvent(
+  db: PgQueryable,
+  input: AppendBusinessEventInput,
+): Promise<AppendBusinessEventResult> {
+  assertValidBusinessEventType(input.eventType);
+  const eventType = input.eventType.trim();
+
+  const dateParsed = parseDateOnly(input.effectiveDate);
+  if (!dateParsed.ok) {
+    throw new BusinessEventValidationError(
+      "invalid_effective_date",
+      `effectiveDate must be YYYY-MM-DD date-only (${dateParsed.reason})`,
+    );
+  }
+
+  if (!input.personId?.trim()) {
+    throw new BusinessEventValidationError(
+      "invalid_person_id",
+      "personId is required",
+    );
+  }
+  if (!input.registeredBy?.trim()) {
+    throw new BusinessEventValidationError(
+      "invalid_registered_by",
+      "registeredBy is required",
+    );
+  }
+  if (!input.correlationId?.trim()) {
+    throw new BusinessEventValidationError(
+      "invalid_correlation_id",
+      "correlationId is required",
+    );
+  }
+
+  const status: BusinessEventStatus = input.status ?? "Draft";
+  const registeredAt = input.registeredAt ?? new Date();
+  const provenance = input.provenance ?? {};
+  const scope = input.scope ?? {};
+  const payload = input.payload ?? {};
+
+  assertNoSensitiveEvidence("provenance", provenance);
+  assertNoSensitiveEvidence("beforeEvidence", input.beforeEvidence);
+  assertNoSensitiveEvidence("afterEvidence", input.afterEvidence);
+  assertNoSensitiveEvidence("payload", payload);
+
+  const id = randomUUID();
+  const registeredBy = input.registeredBy.trim();
+
+  await db.query(
+    `INSERT INTO kernel_events (
+       id, event_class, correlation_id, actor_account_id, occurred_at,
+       operation, scope, result, reason, entity_type, entity_id, payload,
+       event_type, person_id, employment_id, effective_date,
+       registered_at, registered_by, finalized_at, finalized_by,
+       status, reference_code, provenance, before_evidence, after_evidence,
+       corrects_event_id, cancels_event_id, reverses_event_id, supersedes_event_id
+     ) VALUES (
+       $1::uuid, 'business', $2::uuid, $3, $4,
+       $5, $6::jsonb, NULL, $7, 'person', $8, $9::jsonb,
+       $10, $11::uuid, $12::uuid, $13::date,
+       $14, $15, $16, $17,
+       $18, $19, $20::jsonb, $21::jsonb, $22::jsonb,
+       $23::uuid, $24::uuid, $25::uuid, $26::uuid
+     )`,
+    [
+      id,
+      input.correlationId,
+      registeredBy,
+      registeredAt.toISOString(),
+      // operation NOT NULL: mirror event type; event_type column is SoT for type
+      eventType,
+      JSON.stringify(scope),
+      input.reason ?? null,
+      input.personId,
+      JSON.stringify(payload),
+      eventType,
+      input.personId,
+      input.employmentId ?? null,
+      dateParsed.value,
+      registeredAt.toISOString(),
+      registeredBy,
+      input.finalizedAt ? input.finalizedAt.toISOString() : null,
+      input.finalizedBy ?? null,
+      status,
+      input.referenceCode ?? null,
+      JSON.stringify(provenance),
+      input.beforeEvidence == null
+        ? null
+        : JSON.stringify(input.beforeEvidence),
+      input.afterEvidence == null ? null : JSON.stringify(input.afterEvidence),
+      input.correctsEventId ?? null,
+      input.cancelsEventId ?? null,
+      input.reversesEventId ?? null,
+      input.supersedesEventId ?? null,
+    ],
+  );
+
+  return { id };
+}
