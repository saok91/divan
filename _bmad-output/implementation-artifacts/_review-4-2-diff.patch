+-- Story 4.2: Mutable Draft working store (FR-15).
+-- Non-authoritative — NOT kernel_events. Soft-delete via status=deleted.
+
+CREATE TABLE "PersonnelEventDraft" (
+    "id" TEXT NOT NULL,
+    "personId" TEXT NOT NULL,
+    "employmentId" TEXT,
+    "eventType" TEXT NOT NULL,
+    "effectiveDate" DATE NOT NULL,
+    "payload" JSONB NOT NULL DEFAULT '{}',
+    "status" TEXT NOT NULL DEFAULT 'open',
+    "version" INTEGER NOT NULL DEFAULT 1,
+    "createdBy" TEXT NOT NULL,
+    "updatedBy" TEXT NOT NULL,
+    "finalizedEventId" TEXT,
+    "idempotencyKey" TEXT,
+    "warningAcks" JSONB,
+    "overrideEvidence" JSONB,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "PersonnelEventDraft_pkey" PRIMARY KEY ("id")
+);
+
+CREATE UNIQUE INDEX "PersonnelEventDraft_idempotencyKey_key" ON "PersonnelEventDraft"("idempotencyKey");
+
+CREATE INDEX "PersonnelEventDraft_personId_status_idx" ON "PersonnelEventDraft"("personId", "status");
+
+CREATE INDEX "PersonnelEventDraft_finalizedEventId_idx" ON "PersonnelEventDraft"("finalizedEventId");
+
+CREATE INDEX "PersonnelEventDraft_status_updatedAt_idx" ON "PersonnelEventDraft"("status", "updatedAt");
diff --git a/packages/modules/person-employment/src/personnel-event-conflicts.ts b/packages/modules/person-employment/src/personnel-event-conflicts.ts
new file mode 100644
index 0000000..dafd5dc
--- /dev/null
+++ b/packages/modules/person-employment/src/personnel-event-conflicts.ts
@@ -0,0 +1,400 @@
+/**
+ * Evaluation snapshot + conflict classification (Story 4.2 / FR-19 / FR-56).
+ * Fail-closed stubs for AR-TEMPORAL / AR-HEADCOUNT — do not invent frozen matrices.
+ */
+
+import { todayDateOnlyTehran, parseDateOnly } from "@divan/temporal-engine";
+import type { PrismaClient } from "@divan/db";
+
+import { getPersonDb } from "./db";
+import {
+  MSG_BASELINE_BOUNDARY_BLOCKED_FA,
+  MSG_HEADCOUNT_CHECK_BLOCKED_FA,
+  MSG_INVALID_DRAFT_EFFECTIVE_DATE_FA,
+} from "./errors";
+import type { PersonnelEventDraftRecord } from "./personnel-event-draft";
+import { isEmploymentActiveAsOf } from "./employment";
+import { getGradeById } from "./job-reference";
+import { JobRefError } from "./errors";
+
+export type ConflictSeverity = "blocking" | "warning";
+
+export type ConflictFinding = {
+  code: string;
+  severity: ConflictSeverity;
+  messageFa: string;
+  /** When true, warning may proceed only with recorded acknowledgement. */
+  requiresAck?: boolean;
+  /** When true, only Override path (HR Admin / configured) may proceed. */
+  requiresOverride?: boolean;
+};
+
+export type EvaluationSnapshot = {
+  /** Asia/Tehran date-only as-of for checks (FR-56). */
+  asOfDate: string;
+  actorAccountId: string;
+  /** PermissionSet fingerprint or joined permission keys for attribution. */
+  permissionSetFingerprint: string;
+  correlationId: string;
+  /** Frozen Person stamp. */
+  person: { id: string; updatedAt: string };
+  /** Frozen Employment stamp when bound. */
+  employment: {
+    id: string;
+    updatedAt: string;
+    startDate: string;
+    endDateExclusive: string | null;
+  } | null;
+  /** Optional org/job refs from draft payload (structural ids only). */
+  refs: {
+    ladderId?: string;
+    gradeId?: string;
+    teamId?: string;
+    organizationalRoleId?: string;
+    jobTitleId?: string;
+  };
+  builtAt: string;
+};
+
+export type BuildSnapshotInput = {
+  draft: PersonnelEventDraftRecord;
+  actorAccountId: string;
+  correlationId: string;
+  permissionSetFingerprint?: string;
+  asOfDate?: string;
+};
+
+/** Event types that would consume headcount — stub-block until headcount module exists. */
+export const HEADCOUNT_CONSUMING_EVENT_TYPES = new Set([
+  "EmploymentStarted",
+  "TransferRecorded",
+  "TeamTransferRecorded",
+  "HeadcountConsumed",
+]);
+
+/**
+ * Warning allow-list — only these codes may proceed with acknowledgement.
+ * Everything else that is a warning without policy stays blocking.
+ */
+export const WARNING_ACK_ALLOW_LIST = new Set([
+  "PRE_BASELINE_EFFECTIVE_DATE",
+]);
+
+export type ConflictPolicy = {
+  /** When set, Effective Date before this boundary needs Override (+ ack). */
+  baselineBoundaryDate?: string | null;
+  /** When true, PRE_BASELINE can be Override'd by HR Admin path. */
+  allowPreBaselineOverride?: boolean;
+  /** Codes that may proceed with warning acknowledgement. */
+  warningAckAllowList?: Set<string>;
+};
+
+function dateOnlyFromDb(d: Date): string {
+  return d.toISOString().slice(0, 10);
+}
+
+export async function buildEvaluationSnapshot(
+  input: BuildSnapshotInput,
+  db: PrismaClient = getPersonDb(),
+): Promise<EvaluationSnapshot> {
+  const asOf =
+    input.asOfDate != null
+      ? (() => {
+          const p = parseDateOnly(input.asOfDate);
+          if (!p.ok) {
+            throw new Error(`invalid_as_of:${p.reason}`);
+          }
+          return p.value;
+        })()
+      : todayDateOnlyTehran();
+
+  const person = await db.person.findUnique({
+    where: { id: input.draft.personId },
+  });
+  if (!person) {
+    throw new Error("person_not_found_for_snapshot");
+  }
+
+  let employment: EvaluationSnapshot["employment"] = null;
+  if (input.draft.employmentId) {
+    const emp = await db.employment.findUnique({
+      where: { id: input.draft.employmentId },
+    });
+    if (emp) {
+      employment = {
+        id: emp.id,
+        updatedAt: emp.updatedAt.toISOString(),
+        startDate: dateOnlyFromDb(emp.startDate),
+        endDateExclusive: emp.endDateExclusive
+          ? dateOnlyFromDb(emp.endDateExclusive)
+          : null,
+      };
+    }
+  }
+
+  const payload = input.draft.payload;
+  const refs: EvaluationSnapshot["refs"] = {};
+  for (const key of [
+    "ladderId",
+    "gradeId",
+    "teamId",
+    "organizationalRoleId",
+    "jobTitleId",
+  ] as const) {
+    const v = payload[key];
+    if (typeof v === "string" && v.trim()) {
+      refs[key] = v.trim();
+    }
+  }
+
+  return {
+    asOfDate: asOf,
+    actorAccountId: input.actorAccountId,
+    permissionSetFingerprint:
+      input.permissionSetFingerprint?.trim() || "unspecified",
+    correlationId: input.correlationId,
+    person: {
+      id: person.id,
+      updatedAt: person.updatedAt.toISOString(),
+    },
+    employment,
+    refs,
+    builtAt: new Date().toISOString(),
+  };
+}
+
+/**
+ * Re-validate client-supplied snapshot against live stamps.
+ * Stale refs → block (FR-56).
+ */
+export function assertSnapshotFresh(
+  snapshot: EvaluationSnapshot,
+  live: EvaluationSnapshot,
+): ConflictFinding | null {
+  if (snapshot.person.id !== live.person.id) {
+    return {
+      code: "STALE_PERSON_REF",
+      severity: "blocking",
+      messageFa:
+        "مرجع فرد در اسنپ‌شات ارزیابی با وضعیت فعلی هم‌خوان نیست؛ نهایی‌سازی مسدود است.",
+    };
+  }
+  if (snapshot.person.updatedAt !== live.person.updatedAt) {
+    return {
+      code: "STALE_PERSON_REF",
+      severity: "blocking",
+      messageFa:
+        "فرد پس از ساخت اسنپ‌شات تغییر کرده است؛ دوباره بررسی کنید.",
+    };
+  }
+  if (
+    (snapshot.employment?.id ?? null) !== (live.employment?.id ?? null) ||
+    (snapshot.employment?.updatedAt ?? null) !==
+      (live.employment?.updatedAt ?? null)
+  ) {
+    return {
+      code: "STALE_EMPLOYMENT_REF",
+      severity: "blocking",
+      messageFa:
+        "سابقه همکاری پس از ساخت اسنپ‌شات تغییر کرده است؛ نهایی‌سازی مسدود است.",
+    };
+  }
+  return null;
+}
+
+export async function classifyConflicts(
+  draft: PersonnelEventDraftRecord,
+  snapshot: EvaluationSnapshot,
+  policy: ConflictPolicy = {},
+  db: PrismaClient = getPersonDb(),
+): Promise<ConflictFinding[]> {
+  const findings: ConflictFinding[] = [];
+  const warningAllow =
+    policy.warningAckAllowList ?? WARNING_ACK_ALLOW_LIST;
+
+  const dateParsed = parseDateOnly(draft.effectiveDate);
+  if (!dateParsed.ok) {
+    findings.push({
+      code: "INVALID_EFFECTIVE_DATE",
+      severity: "blocking",
+      messageFa: MSG_INVALID_DRAFT_EFFECTIVE_DATE_FA,
+    });
+    return findings;
+  }
+
+  // Broken correction refs (if draft carries them)
+  for (const key of [
+    "correctsEventId",
+    "cancelsEventId",
+    "reversesEventId",
+  ] as const) {
+    const ref = draft.payload[key];
+    if (typeof ref === "string" && ref.trim()) {
+      // Application-level UUID shape check; existence validated when event-store lookup lands (4.3)
+      const uuidOk =
+        /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
+          ref.trim(),
+        );
+      if (!uuidOk) {
+        findings.push({
+          code: "BROKEN_CORRECTION_REF",
+          severity: "blocking",
+          messageFa:
+            "ارجاع اصلاح/لغو/بازگشت نامعتبر است؛ نهایی‌سازی مسدود است.",
+        });
+      }
+    }
+  }
+
+  // Inactive Employment mutation — when employment is bound and as-of is outside interval
+  if (draft.employmentId && snapshot.employment) {
+    const active = isEmploymentActiveAsOf(
+      {
+        startDate: snapshot.employment.startDate,
+        endDateExclusive: snapshot.employment.endDateExclusive,
+      },
+      snapshot.asOfDate,
+    );
+    if (!active) {
+      findings.push({
+        code: "INACTIVE_EMPLOYMENT_MUTATION",
+        severity: "blocking",
+        messageFa:
+          "تغییر روی همکاری غیرفعال در تاریخ ارزیابی مجاز نیست؛ نهایی‌سازی مسدود است.",
+      });
+    }
+  } else if (draft.employmentId && !snapshot.employment) {
+    findings.push({
+      code: "EMPLOYMENT_REF_MISSING",
+      severity: "blocking",
+      messageFa:
+        "سابقه همکاری پیوست‌شده یافت نشد؛ نهایی‌سازی مسدود است.",
+    });
+  }
+
+  // Overlapping Employments / Primary — prove with Epic 3 as-of when starting new employment
+  if (draft.eventType === "EmploymentStarted") {
+    const active = await db.employment.findMany({
+      where: {
+        personId: draft.personId,
+        startDate: { lte: new Date(`${snapshot.asOfDate}T00:00:00.000Z`) },
+        OR: [
+          { endDateExclusive: null },
+          {
+            endDateExclusive: {
+              gt: new Date(`${snapshot.asOfDate}T00:00:00.000Z`),
+            },
+          },
+        ],
+      },
+    });
+    if (active.length > 0) {
+      findings.push({
+        code: "OVERLAPPING_EMPLOYMENT",
+        severity: "blocking",
+        messageFa:
+          "هم‌پوشانی همکاری فعال وجود دارد؛ شروع همکاری جدید بدون بستن قبلی مسدود است.",
+      });
+    }
+  }
+
+  // Ladder–Grade invalid
+  if (snapshot.refs.ladderId && snapshot.refs.gradeId) {
+    try {
+      const grade = await getGradeById(snapshot.refs.gradeId, db);
+      if (!grade || grade.ladderId !== snapshot.refs.ladderId) {
+        findings.push({
+          code: "LADDER_GRADE_INVALID",
+          severity: "blocking",
+          messageFa: "گرید به لدر انتخاب‌شده تعلق ندارد.",
+        });
+      }
+    } catch (err) {
+      if (err instanceof JobRefError) {
+        findings.push({
+          code: "LADDER_GRADE_INVALID",
+          severity: "blocking",
+          messageFa: err.messageFa,
+        });
+      } else {
+        findings.push({
+          code: "LADDER_GRADE_INVALID",
+          severity: "blocking",
+          messageFa: "گرید به لدر انتخاب‌شده تعلق ندارد.",
+        });
+      }
+    }
+  }
+
+  // Headcount consuming types — fail-closed stub while headcount module empty
+  if (HEADCOUNT_CONSUMING_EVENT_TYPES.has(draft.eventType)) {
+    findings.push({
+      code: "HEADCOUNT_UNAPPROVED",
+      severity: "blocking",
+      messageFa: MSG_HEADCOUNT_CHECK_BLOCKED_FA,
+    });
+  }
+
+  // Pre-Baseline boundary (AR-TEMPORAL partial freeze)
+  const baseline = policy.baselineBoundaryDate?.trim() || null;
+  if (baseline) {
+    const b = parseDateOnly(baseline);
+    if (b.ok && draft.effectiveDate < b.value) {
+      if (policy.allowPreBaselineOverride) {
+        findings.push({
+          code: "PRE_BASELINE_EFFECTIVE_DATE",
+          severity: "warning",
+          messageFa: MSG_BASELINE_BOUNDARY_BLOCKED_FA,
+          requiresAck: true,
+          requiresOverride: true,
+        });
+      } else {
+        findings.push({
+          code: "PRE_BASELINE_EFFECTIVE_DATE",
+          severity: "blocking",
+          messageFa: MSG_BASELINE_BOUNDARY_BLOCKED_FA,
+        });
+      }
+    }
+  } else if (draft.payload.requireBaselineCheck === true) {
+    // Baseline not configured but draft demanded check — fail-closed
+    findings.push({
+      code: "BASELINE_NOT_CONFIGURED",
+      severity: "blocking",
+      messageFa:
+        "مرز Baseline پیکربندی نشده است؛ پذیرش خاموش تاریخ پیش از Baseline مجاز نیست.",
+    });
+  }
+
+  // Downgrade unknown warnings that are not on allow-list to blocking
+  for (const f of findings) {
+    if (
+      f.severity === "warning" &&
+      f.requiresAck &&
+      !warningAllow.has(f.code)
+    ) {
+      f.severity = "blocking";
+      delete f.requiresAck;
+    }
+  }
+
+  return findings;
+}
+
+export function hasBlockingConflicts(findings: ConflictFinding[]): boolean {
+  return findings.some((f) => f.severity === "blocking");
+}
+
+export function warningCodesRequiringAck(
+  findings: ConflictFinding[],
+): string[] {
+  return findings
+    .filter((f) => f.severity === "warning" && f.requiresAck)
+    .map((f) => f.code);
+}
+
+export function codesRequiringOverride(
+  findings: ConflictFinding[],
+): string[] {
+  return findings.filter((f) => f.requiresOverride).map((f) => f.code);
+}
diff --git a/packages/modules/person-employment/src/personnel-event-draft.selfcheck.ts b/packages/modules/person-employment/src/personnel-event-draft.selfcheck.ts
new file mode 100644
index 0000000..939c271
--- /dev/null
+++ b/packages/modules/person-employment/src/personnel-event-draft.selfcheck.ts
@@ -0,0 +1,412 @@
+/**
+ * Personnel Event Draft / finalize selfcheck (Story 4.2 / FR-15 / FR-19 / AD-6).
+ * Run: pnpm --filter @divan/person-employment selfcheck:personnel-event-draft
+ * Requires DATABASE_URL, migrated Draft table + kernel_events SQL, seeded accounts.
+ */
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { config as loadEnv } from "dotenv";
+
+import { createPgPool } from "@divan/db";
+import { withTransaction } from "@divan/event-store";
+
+import {
+  PersonnelEventError,
+  createDraft,
+  deleteDraft,
+  finalizeDraft,
+  getDraft,
+  getPersonDb,
+  resetProjectionRefreshHook,
+  seedPersonIdentityFixtures,
+  setProjectionRefreshHook,
+  updateDraft,
+  SEED_PERSON_IDENTITY,
+} from "./index";
+
+const rootEnv = resolve(
+  fileURLToPath(new URL(".", import.meta.url)),
+  "../../../../.env",
+);
+loadEnv({ path: rootEnv });
+
+async function countBusinessEvents(
+  pool: ReturnType<typeof createPgPool>,
+  personId: string,
+  draftId: string,
+): Promise<number> {
+  const r = await pool.query(
+    `SELECT count(*)::int AS n FROM kernel_events
+     WHERE event_class = 'business'
+       AND person_id = $1::uuid
+       AND payload->>'draftId' = $2`,
+    [personId, draftId],
+  );
+  return r.rows[0]?.n ?? 0;
+}
+
+async function main() {
+  const url = process.env.DATABASE_URL?.trim();
+  assert.ok(url, "DATABASE_URL required");
+
+  const db = getPersonDb();
+  const pool = createPgPool(url);
+  await seedPersonIdentityFixtures(db);
+
+  const demo = await db.person.findUnique({
+    where: { personnelCode: SEED_PERSON_IDENTITY.demoPersonnelCode },
+  });
+  assert.ok(demo, "demo person required");
+
+  const actor =
+    (await db.internalAccount.findUnique({ where: { username: "hr.operator" } }))
+      ?.id ?? "selfcheck-actor";
+
+  let hookCalls = 0;
+  setProjectionRefreshHook(async (ctx) => {
+    hookCalls += 1;
+    ctx.invoked = { eventId: ctx.eventId, eventType: ctx.eventType };
+  });
+
+  try {
+    // --- Create / edit / delete Draft: no kernel_events, no projection ---
+    const draft = await createDraft(
+      {
+        personId: demo.id,
+        eventType: "ScaffoldChangeRecorded",
+        effectiveDate: "2025-06-15",
+        payload: { note: "scaffold" },
+      },
+      { accountId: actor },
+      db,
+    );
+    assert.equal(draft.status, "open");
+    assert.equal(draft.version, 1);
+
+    const beforeCreate = await countBusinessEvents(pool, demo.id, draft.id);
+    assert.equal(beforeCreate, 0, "draft create must not append kernel event");
+
+    const updated = await updateDraft(
+      {
+        draftId: draft.id,
+        expectedVersion: 1,
+        effectiveDate: "2025-07-01",
+        payload: { note: "edited" },
+      },
+      { accountId: actor },
+      db,
+    );
+    assert.equal(updated.version, 2);
+    assert.equal(updated.effectiveDate, "2025-07-01");
+    assert.equal(
+      await countBusinessEvents(pool, demo.id, draft.id),
+      0,
+      "draft update must not append",
+    );
+
+    const deleted = await deleteDraft(draft.id, 2, { accountId: actor }, db);
+    assert.equal(deleted.status, "deleted");
+
+    // Cannot finalize deleted
+    await assert.rejects(
+      () =>
+        finalizeDraft(
+          { draftId: draft.id, actorId: actor },
+          pool,
+          db,
+        ),
+      (err: unknown) =>
+        err instanceof PersonnelEventError && err.code === "DRAFT_DELETED",
+    );
+
+    // --- Finalize happy path ---
+    const draft2 = await createDraft(
+      {
+        personId: demo.id,
+        eventType: "ScaffoldChangeRecorded",
+        effectiveDate: "2025-06-15",
+        payload: { scaffold: true },
+      },
+      { accountId: actor },
+      db,
+    );
+    const idem = `selfcheck-finalize-${draft2.id}`;
+    hookCalls = 0;
+    const fin = await finalizeDraft(
+      {
+        draftId: draft2.id,
+        actorId: actor,
+        idempotencyKey: idem,
+        expectedVersion: draft2.version,
+        correlationId: randomUUID(),
+      },
+      pool,
+      db,
+    );
+    assert.equal(fin.outcome, "finalized");
+    if (fin.outcome !== "finalized") throw new Error("expected finalized");
+    assert.ok(fin.eventId);
+    assert.ok(
+      fin.status === "Effective" || fin.status === "Scheduled",
+      `status ${fin.status}`,
+    );
+    assert.equal(fin.draft.status, "finalized");
+    assert.equal(fin.draft.finalizedEventId, fin.eventId);
+    assert.equal(hookCalls, 1, "AD-6 projection hook must run once");
+    assert.equal(fin.projectionHookInvoked, true);
+
+    const row = await pool.query(
+      `SELECT status, finalized_at, finalized_by, event_type
+       FROM kernel_events WHERE id = $1::uuid`,
+      [fin.eventId],
+    );
+    assert.equal(row.rows.length, 1);
+    assert.ok(row.rows[0].finalized_at);
+    assert.equal(row.rows[0].finalized_by, actor);
+    assert.equal(row.rows[0].event_type, "ScaffoldChangeRecorded");
+    assert.ok(
+      row.rows[0].status === "Effective" || row.rows[0].status === "Scheduled",
+    );
+
+    // Exact cardinality: one event
+    assert.equal(await countBusinessEvents(pool, demo.id, draft2.id), 1);
+
+    // --- Idempotent retry → same event id ---
+    const retry = await finalizeDraft(
+      {
+        draftId: draft2.id,
+        actorId: actor,
+        idempotencyKey: idem,
+      },
+      pool,
+      db,
+    );
+    assert.equal(retry.outcome, "finalized");
+    if (retry.outcome === "finalized") {
+      assert.equal(retry.eventId, fin.eventId);
+    }
+    assert.equal(
+      await countBusinessEvents(pool, demo.id, draft2.id),
+      1,
+      "retry must not create second event",
+    );
+
+    // --- No UPDATE on kernel_events ---
+    await assert.rejects(async () => {
+      await pool.query(
+        `UPDATE kernel_events SET status = 'Draft' WHERE id = $1::uuid`,
+        [fin.eventId],
+      );
+    });
+
+    // --- Blocking conflict (headcount-consuming type) ---
+    const draftBlock = await createDraft(
+      {
+        personId: demo.id,
+        eventType: "EmploymentStarted",
+        effectiveDate: "2025-08-01",
+        payload: {},
+      },
+      { accountId: actor },
+      db,
+    );
+    const blocked = await finalizeDraft(
+      {
+        draftId: draftBlock.id,
+        actorId: actor,
+        expectedVersion: draftBlock.version,
+      },
+      pool,
+      db,
+    );
+    assert.equal(blocked.outcome, "rejected");
+    if (blocked.outcome === "rejected") {
+      assert.equal(blocked.code, "FINALIZE_BLOCKED");
+      assert.ok(
+        blocked.conflicts.some((c) => c.severity === "blocking"),
+        "blocking conflict required",
+      );
+    }
+    const stillOpen = await getDraft(draftBlock.id, db);
+    assert.equal(stillOpen.status, "open");
+    assert.equal(await countBusinessEvents(pool, demo.id, draftBlock.id), 0);
+
+    // --- Warning requires ack ---
+    const draftWarn = await createDraft(
+      {
+        personId: demo.id,
+        eventType: "ScaffoldChangeRecorded",
+        effectiveDate: "2010-01-01",
+        payload: {},
+      },
+      { accountId: actor },
+      db,
+    );
+    const warnReject = await finalizeDraft(
+      {
+        draftId: draftWarn.id,
+        actorId: actor,
+        expectedVersion: draftWarn.version,
+        conflictPolicy: {
+          baselineBoundaryDate: "2020-01-01",
+          allowPreBaselineOverride: true,
+        },
+        actorMayOverride: true,
+        // missing acknowledgement
+      },
+      pool,
+      db,
+    );
+    assert.equal(warnReject.outcome, "rejected");
+    if (warnReject.outcome === "rejected") {
+      assert.ok(
+        warnReject.code === "FINALIZE_WARNING_ACK_REQUIRED" ||
+          warnReject.code === "FINALIZE_OVERRIDE_REQUIRED",
+      );
+    }
+
+    const warnOk = await finalizeDraft(
+      {
+        draftId: draftWarn.id,
+        actorId: actor,
+        expectedVersion: draftWarn.version,
+        conflictPolicy: {
+          baselineBoundaryDate: "2020-01-01",
+          allowPreBaselineOverride: true,
+        },
+        actorMayOverride: true,
+        acknowledgement: {
+          warningCodes: ["PRE_BASELINE_EFFECTIVE_DATE"],
+        },
+        override: {
+          reason: "selfcheck override for pre-baseline scaffold",
+          approvedByAccountId: actor,
+        },
+      },
+      pool,
+      db,
+    );
+    assert.equal(warnOk.outcome, "finalized");
+
+    // --- Risk tier → pending_review (non-authoritative) ---
+    const draftRisk = await createDraft(
+      {
+        personId: demo.id,
+        eventType: "EmploymentTerminated",
+        effectiveDate: "2025-09-01",
+        payload: { riskTier: "termination" },
+      },
+      { accountId: actor },
+      db,
+    );
+    const pending = await finalizeDraft(
+      {
+        draftId: draftRisk.id,
+        actorId: actor,
+        expectedVersion: draftRisk.version,
+        // no risk tier config → pending_review
+      },
+      pool,
+      db,
+    );
+    assert.equal(pending.outcome, "pending_review");
+    if (pending.outcome === "pending_review") {
+      assert.equal(pending.draft.status, "pending_review");
+    }
+    assert.equal(await countBusinessEvents(pool, demo.id, draftRisk.id), 0);
+
+    // --- Delete vs finalize race: finalize wins under lock ---
+    const raceDraft = await createDraft(
+      {
+        personId: demo.id,
+        eventType: "ScaffoldChangeRecorded",
+        effectiveDate: "2025-10-01",
+        payload: {},
+      },
+      { accountId: actor },
+      db,
+    );
+    const raceFin = await finalizeDraft(
+      {
+        draftId: raceDraft.id,
+        actorId: actor,
+        expectedVersion: raceDraft.version,
+        idempotencyKey: `race-${raceDraft.id}`,
+      },
+      pool,
+      db,
+    );
+    assert.equal(raceFin.outcome, "finalized");
+    await assert.rejects(
+      () =>
+        deleteDraft(raceDraft.id, raceDraft.version, { accountId: actor }, db),
+      (err: unknown) =>
+        err instanceof PersonnelEventError &&
+        (err.code === "DRAFT_ALREADY_FINALIZED" ||
+          err.code === "DRAFT_NOT_EDITABLE" ||
+          err.code === "DRAFT_VERSION_CONFLICT"),
+    );
+    const afterRace = await getDraft(raceDraft.id, db);
+    assert.equal(afterRace.status, "finalized");
+    assert.ok(afterRace.finalizedEventId);
+
+    // --- AD-6: hook + append same txn (rollback rolls both) ---
+    const rollbackDraft = await createDraft(
+      {
+        personId: demo.id,
+        eventType: "ScaffoldChangeRecorded",
+        effectiveDate: "2025-11-01",
+        payload: {},
+      },
+      { accountId: actor },
+      db,
+    );
+    setProjectionRefreshHook(async () => {
+      throw new Error("force_rollback_after_hook_setup");
+    });
+    // Force failure inside finalize after we'd normally append: use a hook that throws
+    // Re-implement via finalize path — hook throws → txn rolls back
+    await assert.rejects(() =>
+      finalizeDraft(
+        {
+          draftId: rollbackDraft.id,
+          actorId: actor,
+          expectedVersion: rollbackDraft.version,
+        },
+        pool,
+        db,
+      ),
+    );
+    const afterRollback = await getDraft(rollbackDraft.id, db);
+    assert.equal(
+      afterRollback.status,
+      "open",
+      "failed finalize must leave draft open",
+    );
+    assert.equal(
+      await countBusinessEvents(pool, demo.id, rollbackDraft.id),
+      0,
+      "rolled-back finalize must not leave kernel event",
+    );
+
+    // Prove withTransaction seam still works for access path companion
+    await withTransaction(pool, async (client) => {
+      const r = await client.query("SELECT 1 AS n");
+      assert.equal(r.rows[0].n, 1);
+    });
+
+    console.log("personnel-event-draft selfcheck: OK");
+  } finally {
+    resetProjectionRefreshHook();
+    await pool.end();
+    await db.$disconnect();
+  }
+}
+
+main().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});
diff --git a/packages/modules/person-employment/src/personnel-event-draft.ts b/packages/modules/person-employment/src/personnel-event-draft.ts
new file mode 100644
index 0000000..4013a69
--- /dev/null
+++ b/packages/modules/person-employment/src/personnel-event-draft.ts
@@ -0,0 +1,369 @@
+/**
+ * Mutable Draft working store (Story 4.2 / FR-15).
+ * Non-authoritative — never mutates kernel_events or projections on save.
+ */
+
+import { assertNoSensitiveEvidence, BusinessEventValidationError } from "@divan/event-store";
+import { parseDateOnly } from "@divan/temporal-engine";
+import type { Prisma, PrismaClient } from "@divan/db";
+
+import { getPersonDb } from "./db";
+import {
+  MSG_DRAFT_ALREADY_FINALIZED_FA,
+  MSG_DRAFT_DELETED_FA,
+  MSG_DRAFT_NOT_EDITABLE_FA,
+  MSG_DRAFT_NOT_FOUND_FA,
+  MSG_DRAFT_VERSION_CONFLICT_FA,
+  MSG_INVALID_DRAFT_EFFECTIVE_DATE_FA,
+  MSG_PERSON_NOT_FOUND_FA,
+  MSG_REQUIRED_FIELD_FA,
+  MSG_SENSITIVE_DRAFT_PAYLOAD_FA,
+  PersonnelEventError,
+} from "./errors";
+import { requireNonEmpty as requireNonEmptyBase } from "./normalize";
+
+function requireNonEmpty(value: string | null | undefined, field: string): string {
+  return requireNonEmptyBase(value, `${MSG_REQUIRED_FIELD_FA} (${field})`);
+}
+
+const EVENT_TYPE_PASCAL_RE = /^[A-Z][A-Za-z0-9]*$/;
+
+export type DraftStatus =
+  | "open"
+  | "finalized"
+  | "deleted"
+  | "pending_review";
+
+export type PersonnelEventDraftRecord = {
+  id: string;
+  personId: string;
+  employmentId: string | null;
+  eventType: string;
+  effectiveDate: string;
+  payload: Record<string, unknown>;
+  status: DraftStatus;
+  version: number;
+  createdBy: string;
+  updatedBy: string;
+  finalizedEventId: string | null;
+  idempotencyKey: string | null;
+  warningAcks: unknown;
+  overrideEvidence: unknown;
+  createdAt: Date;
+  updatedAt: Date;
+};
+
+export type CreateDraftInput = {
+  personId: string;
+  employmentId?: string | null;
+  eventType: string;
+  effectiveDate: string;
+  payload?: Record<string, unknown>;
+  idempotencyKey?: string | null;
+};
+
+export type UpdateDraftInput = {
+  draftId: string;
+  expectedVersion: number;
+  employmentId?: string | null;
+  eventType?: string;
+  effectiveDate?: string;
+  payload?: Record<string, unknown>;
+};
+
+function dateOnlyToDb(dateOnly: string): Date {
+  return new Date(`${dateOnly}T00:00:00.000Z`);
+}
+
+function dateOnlyFromDb(d: Date): string {
+  return d.toISOString().slice(0, 10);
+}
+
+function asPayload(value: unknown): Record<string, unknown> {
+  if (value && typeof value === "object" && !Array.isArray(value)) {
+    return value as Record<string, unknown>;
+  }
+  return {};
+}
+
+function mapDraft(row: {
+  id: string;
+  personId: string;
+  employmentId: string | null;
+  eventType: string;
+  effectiveDate: Date;
+  payload: unknown;
+  status: string;
+  version: number;
+  createdBy: string;
+  updatedBy: string;
+  finalizedEventId: string | null;
+  idempotencyKey: string | null;
+  warningAcks: unknown;
+  overrideEvidence: unknown;
+  createdAt: Date;
+  updatedAt: Date;
+}): PersonnelEventDraftRecord {
+  return {
+    id: row.id,
+    personId: row.personId,
+    employmentId: row.employmentId,
+    eventType: row.eventType,
+    effectiveDate: dateOnlyFromDb(row.effectiveDate),
+    payload: asPayload(row.payload),
+    status: row.status as DraftStatus,
+    version: row.version,
+    createdBy: row.createdBy,
+    updatedBy: row.updatedBy,
+    finalizedEventId: row.finalizedEventId,
+    idempotencyKey: row.idempotencyKey,
+    warningAcks: row.warningAcks,
+    overrideEvidence: row.overrideEvidence,
+    createdAt: row.createdAt,
+    updatedAt: row.updatedAt,
+  };
+}
+
+function assertValidEventType(eventType: string): string {
+  const trimmed = requireNonEmpty(eventType, "eventType");
+  if (!EVENT_TYPE_PASCAL_RE.test(trimmed)) {
+    throw new PersonnelEventError(
+      "VALIDATION",
+      "نوع رویداد نامعتبر است. باید PascalCase باشد (مثلاً ScaffoldChangeRecorded).",
+      "invalid_event_type",
+    );
+  }
+  return trimmed;
+}
+
+function assertValidEffectiveDate(raw: string): string {
+  const parsed = parseDateOnly(raw);
+  if (!parsed.ok) {
+    throw new PersonnelEventError(
+      "INVALID_EFFECTIVE_DATE",
+      MSG_INVALID_DRAFT_EFFECTIVE_DATE_FA,
+      parsed.reason,
+    );
+  }
+  return parsed.value;
+}
+
+function assertSafePayload(payload: Record<string, unknown>): void {
+  try {
+    assertNoSensitiveEvidence("draft.payload", payload);
+  } catch (err) {
+    if (err instanceof BusinessEventValidationError) {
+      throw new PersonnelEventError(
+        "SENSITIVE_PAYLOAD",
+        MSG_SENSITIVE_DRAFT_PAYLOAD_FA,
+        err.code,
+      );
+    }
+    throw err;
+  }
+}
+
+function assertEditable(draft: PersonnelEventDraftRecord): void {
+  if (draft.status === "deleted") {
+    throw new PersonnelEventError("DRAFT_DELETED", MSG_DRAFT_DELETED_FA);
+  }
+  if (draft.status === "finalized") {
+    throw new PersonnelEventError(
+      "DRAFT_ALREADY_FINALIZED",
+      MSG_DRAFT_ALREADY_FINALIZED_FA,
+    );
+  }
+  if (draft.status !== "open" && draft.status !== "pending_review") {
+    throw new PersonnelEventError(
+      "DRAFT_NOT_EDITABLE",
+      MSG_DRAFT_NOT_EDITABLE_FA,
+    );
+  }
+}
+
+export async function createDraft(
+  input: CreateDraftInput,
+  actor: { accountId: string },
+  db: PrismaClient = getPersonDb(),
+): Promise<PersonnelEventDraftRecord> {
+  const personId = requireNonEmpty(input.personId, "personId");
+  const person = await db.person.findUnique({ where: { id: personId } });
+  if (!person) {
+    throw new PersonnelEventError("PERSON_NOT_FOUND", MSG_PERSON_NOT_FOUND_FA);
+  }
+
+  const eventType = assertValidEventType(input.eventType);
+  const effectiveDate = assertValidEffectiveDate(input.effectiveDate);
+  const payload = input.payload ?? {};
+  assertSafePayload(payload);
+
+  if (input.employmentId?.trim()) {
+    const emp = await db.employment.findUnique({
+      where: { id: input.employmentId.trim() },
+    });
+    if (!emp || emp.personId !== personId) {
+      throw new PersonnelEventError(
+        "EMPLOYMENT_NOT_FOUND",
+        "سابقه همکاری یافت نشد یا به این فرد تعلق ندارد.",
+      );
+    }
+  }
+
+  const actorId = requireNonEmpty(actor.accountId, "accountId");
+  const row = await db.personnelEventDraft.create({
+    data: {
+      personId,
+      employmentId: input.employmentId?.trim() || null,
+      eventType,
+      effectiveDate: dateOnlyToDb(effectiveDate),
+      payload: payload as Prisma.InputJsonValue,
+      status: "open",
+      version: 1,
+      createdBy: actorId,
+      updatedBy: actorId,
+      idempotencyKey: input.idempotencyKey?.trim() || null,
+    },
+  });
+  return mapDraft(row);
+}
+
+export async function getDraft(
+  draftId: string,
+  db: PrismaClient = getPersonDb(),
+): Promise<PersonnelEventDraftRecord> {
+  const id = requireNonEmpty(draftId, "draftId");
+  const row = await db.personnelEventDraft.findUnique({ where: { id } });
+  if (!row) {
+    throw new PersonnelEventError("DRAFT_NOT_FOUND", MSG_DRAFT_NOT_FOUND_FA);
+  }
+  return mapDraft(row);
+}
+
+export async function updateDraft(
+  input: UpdateDraftInput,
+  actor: { accountId: string },
+  db: PrismaClient = getPersonDb(),
+): Promise<PersonnelEventDraftRecord> {
+  const existing = await getDraft(input.draftId, db);
+  assertEditable(existing);
+
+  if (existing.version !== input.expectedVersion) {
+    throw new PersonnelEventError(
+      "DRAFT_VERSION_CONFLICT",
+      MSG_DRAFT_VERSION_CONFLICT_FA,
+    );
+  }
+
+  const eventType =
+    input.eventType !== undefined
+      ? assertValidEventType(input.eventType)
+      : existing.eventType;
+  const effectiveDate =
+    input.effectiveDate !== undefined
+      ? assertValidEffectiveDate(input.effectiveDate)
+      : existing.effectiveDate;
+  const payload =
+    input.payload !== undefined ? input.payload : existing.payload;
+  assertSafePayload(payload);
+
+  const employmentId =
+    input.employmentId !== undefined
+      ? input.employmentId?.trim() || null
+      : existing.employmentId;
+
+  if (employmentId) {
+    const emp = await db.employment.findUnique({ where: { id: employmentId } });
+    if (!emp || emp.personId !== existing.personId) {
+      throw new PersonnelEventError(
+        "EMPLOYMENT_NOT_FOUND",
+        "سابقه همکاری یافت نشد یا به این فرد تعلق ندارد.",
+      );
+    }
+  }
+
+  const updated = await db.personnelEventDraft.updateMany({
+    where: {
+      id: existing.id,
+      version: input.expectedVersion,
+      status: { in: ["open", "pending_review"] },
+    },
+    data: {
+      employmentId,
+      eventType,
+      effectiveDate: dateOnlyToDb(effectiveDate),
+      payload: payload as Prisma.InputJsonValue,
+      updatedBy: requireNonEmpty(actor.accountId, "accountId"),
+      version: { increment: 1 },
+    },
+  });
+
+  if (updated.count === 0) {
+    throw new PersonnelEventError(
+      "DRAFT_VERSION_CONFLICT",
+      MSG_DRAFT_VERSION_CONFLICT_FA,
+    );
+  }
+
+  return getDraft(existing.id, db);
+}
+
+export async function deleteDraft(
+  draftId: string,
+  expectedVersion: number,
+  actor: { accountId: string },
+  db: PrismaClient = getPersonDb(),
+): Promise<PersonnelEventDraftRecord> {
+  const existing = await getDraft(draftId, db);
+  assertEditable(existing);
+
+  if (existing.version !== expectedVersion) {
+    throw new PersonnelEventError(
+      "DRAFT_VERSION_CONFLICT",
+      MSG_DRAFT_VERSION_CONFLICT_FA,
+    );
+  }
+
+  const updated = await db.personnelEventDraft.updateMany({
+    where: {
+      id: existing.id,
+      version: expectedVersion,
+      status: { in: ["open", "pending_review"] },
+    },
+    data: {
+      status: "deleted",
+      updatedBy: requireNonEmpty(actor.accountId, "accountId"),
+      version: { increment: 1 },
+    },
+  });
+
+  if (updated.count === 0) {
+    // Race: may have been finalized concurrently
+    const again = await getDraft(draftId, db);
+    if (again.status === "finalized") {
+      throw new PersonnelEventError(
+        "DRAFT_ALREADY_FINALIZED",
+        MSG_DRAFT_ALREADY_FINALIZED_FA,
+      );
+    }
+    throw new PersonnelEventError(
+      "DRAFT_VERSION_CONFLICT",
+      MSG_DRAFT_VERSION_CONFLICT_FA,
+    );
+  }
+
+  return getDraft(existing.id, db);
+}
+
+export async function listOpenDraftsForPerson(
+  personId: string,
+  db: PrismaClient = getPersonDb(),
+): Promise<PersonnelEventDraftRecord[]> {
+  const rows = await db.personnelEventDraft.findMany({
+    where: {
+      personId: requireNonEmpty(personId, "personId"),
+      status: { in: ["open", "pending_review"] },
+    },
+    orderBy: { updatedAt: "desc" },
+  });
+  return rows.map(mapDraft);
+}
