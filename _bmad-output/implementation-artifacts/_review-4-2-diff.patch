diff --git a/apps/web/components/personnel/personnel-event-form.tsx b/apps/web/components/personnel/personnel-event-form.tsx
new file mode 100644
index 0000000..2f4883b
--- /dev/null
+++ b/apps/web/components/personnel/personnel-event-form.tsx
@@ -0,0 +1,420 @@
+"use client";
+
+import * as React from "react";
+
+import { JalaliDatePicker } from "@/components/jalali-date-picker";
+import {
+  ConflictList,
+  SensitiveConfirmationDialog,
+} from "@/components/personnel/sensitive-confirmation-dialog";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { usePlatformStatus } from "@/components/platform-status-provider";
+import { api } from "@/lib/trpc/client";
+import { cn } from "@/lib/utils";
+
+type Conflict = {
+  code: string;
+  severity: "blocking" | "warning";
+  messageFa: string;
+  requiresAck?: boolean;
+};
+
+/**
+ * Minimal فرم رویداد (UX-DR11) — Story 4.2.
+ * Save draft ≠ Finalize. Authoritative events are not editable here.
+ */
+export function PersonnelEventForm() {
+  const formId = React.useId();
+  const {
+    isGoldCtaBlocked,
+    isFinalizeBlockedByAuthzChange,
+    setDemoDraftOpen,
+    setDemoDraftSaved,
+    registerPersonnelDraftSaveHandler,
+  } = usePlatformStatus();
+
+  const [personId, setPersonId] = React.useState("");
+  const [employmentId, setEmploymentId] = React.useState("");
+  const [eventType, setEventType] = React.useState("ScaffoldChangeRecorded");
+  const [effectiveDate, setEffectiveDate] = React.useState("");
+  const [draftId, setDraftId] = React.useState<string | null>(null);
+  const [version, setVersion] = React.useState(1);
+  const [statusMsg, setStatusMsg] = React.useState<string | null>(null);
+  const [errorMsg, setErrorMsg] = React.useState<string | null>(null);
+  const [conflicts, setConflicts] = React.useState<Conflict[]>([]);
+  const [ackCodes, setAckCodes] = React.useState<Set<string>>(new Set());
+  const [confirmOpen, setConfirmOpen] = React.useState(false);
+  const [dirty, setDirty] = React.useState(false);
+
+  const createMut = api.personnelEvent.draftCreate.useMutation();
+  const updateMut = api.personnelEvent.draftUpdate.useMutation();
+  const deleteMut = api.personnelEvent.draftDelete.useMutation();
+  const finalizeMut = api.personnelEvent.finalize.useMutation();
+  const evaluateQuery = api.personnelEvent.evaluate.useQuery(
+    { draftId: draftId! },
+    { enabled: Boolean(draftId) && confirmOpen },
+  );
+
+  React.useEffect(() => {
+    setDemoDraftOpen(Boolean(draftId) || dirty);
+  }, [draftId, dirty, setDemoDraftOpen]);
+
+  const saveDraft = React.useCallback(async (): Promise<boolean> => {
+    setErrorMsg(null);
+    try {
+      if (!personId.trim() || !effectiveDate.trim() || !eventType.trim()) {
+        setErrorMsg("فرد، نوع رویداد و تاریخ مؤثر الزامی است.");
+        return false;
+      }
+      if (draftId) {
+        const updated = await updateMut.mutateAsync({
+          draftId,
+          expectedVersion: version,
+          employmentId: employmentId.trim() || null,
+          eventType: eventType.trim(),
+          effectiveDate: effectiveDate.trim(),
+          payload: {},
+        });
+        setVersion(updated.version);
+        setDraftId(updated.id);
+      } else {
+        const created = await createMut.mutateAsync({
+          personId: personId.trim(),
+          employmentId: employmentId.trim() || null,
+          eventType: eventType.trim(),
+          effectiveDate: effectiveDate.trim(),
+          payload: {},
+        });
+        setDraftId(created.id);
+        setVersion(created.version);
+      }
+      setDirty(false);
+      setDemoDraftSaved(true);
+      setStatusMsg("پیش‌نویس ذخیره شد (غیررسمی — وضعیت فعلی تغییر نکرد).");
+      return true;
+    } catch (err) {
+      const msg =
+        err && typeof err === "object" && "message" in err
+          ? String((err as { message: unknown }).message)
+          : "ذخیره پیش‌نویس ناموفق بود.";
+      setErrorMsg(msg);
+      return false;
+    }
+  }, [
+    personId,
+    employmentId,
+    eventType,
+    effectiveDate,
+    draftId,
+    version,
+    createMut,
+    updateMut,
+    setDemoDraftSaved,
+  ]);
+
+  React.useEffect(() => {
+    registerPersonnelDraftSaveHandler(saveDraft);
+    return () => registerPersonnelDraftSaveHandler(null);
+  }, [registerPersonnelDraftSaveHandler, saveDraft]);
+
+  React.useEffect(() => {
+    const onBeforeUnload = (e: BeforeUnloadEvent) => {
+      if (dirty) {
+        e.preventDefault();
+        e.returnValue = "";
+      }
+    };
+    window.addEventListener("beforeunload", onBeforeUnload);
+    return () => window.removeEventListener("beforeunload", onBeforeUnload);
+  }, [dirty]);
+
+  React.useEffect(() => {
+    if (evaluateQuery.data?.conflicts) {
+      setConflicts(evaluateQuery.data.conflicts as Conflict[]);
+    }
+  }, [evaluateQuery.data]);
+
+  const blocking = conflicts.some((c) => c.severity === "blocking");
+  const warningsNeedingAck = conflicts.filter(
+    (c) => c.severity === "warning" && c.requiresAck,
+  );
+  const ackComplete = warningsNeedingAck.every((w) => ackCodes.has(w.code));
+  const finalizeBlocked =
+    isGoldCtaBlocked ||
+    isFinalizeBlockedByAuthzChange ||
+    blocking ||
+    !ackComplete;
+
+  async function onFinalizeConfirm() {
+    if (!draftId || finalizeBlocked) return;
+    setErrorMsg(null);
+    try {
+      const result = await finalizeMut.mutateAsync({
+        draftId,
+        expectedVersion: version,
+        idempotencyKey: `ui-${draftId}`,
+        acknowledgement:
+          warningsNeedingAck.length > 0
+            ? { warningCodes: [...ackCodes] }
+            : undefined,
+      });
+      if (result.outcome === "finalized") {
+        setStatusMsg(
+          `نهایی شد. رویداد معتبر: ${result.eventId} (${result.status})`,
+        );
+        setDraftId(null);
+        setVersion(1);
+        setDirty(false);
+        setDemoDraftOpen(false);
+        setConfirmOpen(false);
+        setConflicts([]);
+      } else if (result.outcome === "pending_review") {
+        setStatusMsg(result.messageFa);
+        setVersion(result.draft.version);
+        setConfirmOpen(false);
+      }
+    } catch (err) {
+      const msg =
+        err && typeof err === "object" && "message" in err
+          ? String((err as { message: unknown }).message)
+          : "نهایی‌سازی ناموفق بود.";
+      setErrorMsg(msg);
+    }
+  }
+
+  async function onDelete() {
+    if (!draftId) return;
+    try {
+      await deleteMut.mutateAsync({
+        draftId,
+        expectedVersion: version,
+      });
+      setDraftId(null);
+      setVersion(1);
+      setDirty(false);
+      setDemoDraftOpen(false);
+      setStatusMsg("پیش‌نویس حذف شد.");
+    } catch (err) {
+      const msg =
+        err && typeof err === "object" && "message" in err
+          ? String((err as { message: unknown }).message)
+          : "حذف پیش‌نویس ناموفق بود.";
+      setErrorMsg(msg);
+    }
+  }
+
+  return (
+    <section
+      className="mx-auto max-w-4xl space-y-6"
+      aria-labelledby={`${formId}-title`}
+    >
+      <header className="space-y-1">
+        <h2 id={`${formId}-title`} className="text-title-medium">
+          فرم رویداد پرسنلی
+        </h2>
+        <p className="text-body text-muted-foreground">
+          ذخیره پیش‌نویس وضعیت فعلی را تغییر نمی‌دهد. نهایی‌سازی رویداد معتبر
+          می‌سازد.
+        </p>
+      </header>
+
+      <form
+        className="space-y-5"
+        onSubmit={(e) => {
+          e.preventDefault();
+          void saveDraft();
+        }}
+        onChange={() => setDirty(true)}
+      >
+        <fieldset className="space-y-3">
+          <legend className="text-label-medium">شناسه‌ها</legend>
+          <label className="block space-y-1">
+            <span className="text-label-medium">
+              شناسه فرد <span className="text-destructive">*</span>
+            </span>
+            <Input
+              value={personId}
+              onChange={(e) => setPersonId(e.target.value)}
+              required
+              dir="ltr"
+              autoComplete="off"
+            />
+          </label>
+          <label className="block space-y-1">
+            <span className="text-label-medium">شناسه همکاری (اختیاری)</span>
+            <Input
+              value={employmentId}
+              onChange={(e) => setEmploymentId(e.target.value)}
+              dir="ltr"
+              autoComplete="off"
+            />
+          </label>
+        </fieldset>
+
+        <fieldset className="space-y-3">
+          <legend className="text-label-medium">رویداد</legend>
+          <label className="block space-y-1">
+            <span className="text-label-medium">
+              نوع رویداد <span className="text-destructive">*</span>
+            </span>
+            <Input
+              value={eventType}
+              onChange={(e) => setEventType(e.target.value)}
+              required
+              dir="ltr"
+              autoComplete="off"
+            />
+          </label>
+          <div className="space-y-1">
+            <span className="text-label-medium">
+              تاریخ مؤثر <span className="text-destructive">*</span>
+            </span>
+            <p className="text-xs text-muted-foreground">
+              متمایز از زمان ثبت/نهایی‌سازی — فقط روز تقویمی.
+            </p>
+            <JalaliDatePicker
+              aria-label="تاریخ مؤثر"
+              value={effectiveDate || undefined}
+              onChange={(v) => {
+                setEffectiveDate(v ?? "");
+                setDirty(true);
+              }}
+            />
+          </div>
+        </fieldset>
+
+        {conflicts.length > 0 ? (
+          <div className="space-y-2">
+            <h3 className="text-label-medium">تعارض‌ها</h3>
+            <ConflictList conflicts={conflicts} />
+            {warningsNeedingAck.map((w) => (
+              <label
+                key={w.code}
+                className="flex items-start gap-2 text-sm"
+              >
+                <input
+                  type="checkbox"
+                  className="mt-1"
+                  checked={ackCodes.has(w.code)}
+                  onChange={(e) => {
+                    setAckCodes((prev) => {
+                      const next = new Set(prev);
+                      if (e.target.checked) next.add(w.code);
+                      else next.delete(w.code);
+                      return next;
+                    });
+                  }}
+                  aria-describedby={`${formId}-ack-${w.code}`}
+                />
+                <span id={`${formId}-ack-${w.code}`}>
+                  پیامد را می‌پذیرم: {w.messageFa}
+                </span>
+              </label>
+            ))}
+          </div>
+        ) : null}
+
+        {errorMsg ? (
+          <p role="alert" className="text-sm text-destructive">
+            {errorMsg}
+          </p>
+        ) : null}
+        {statusMsg ? (
+          <p role="status" className="text-sm text-muted-foreground">
+            {statusMsg}
+          </p>
+        ) : null}
+
+        <footer
+          className={cn(
+            "flex flex-wrap items-center gap-2 border-t border-border pt-4",
+          )}
+        >
+          <Button
+            type="button"
+            variant="ghost"
+            onClick={() => {
+              setPersonId("");
+              setEmploymentId("");
+              setEventType("ScaffoldChangeRecorded");
+              setEffectiveDate("");
+              setDraftId(null);
+              setVersion(1);
+              setDirty(false);
+              setConflicts([]);
+              setErrorMsg(null);
+              setStatusMsg(null);
+              setDemoDraftOpen(false);
+            }}
+          >
+            انصراف
+          </Button>
+          <Button
+            type="submit"
+            variant="secondary"
+            disabled={createMut.isPending || updateMut.isPending}
+          >
+            ذخیره پیش‌نویس
+          </Button>
+          {draftId ? (
+            <Button
+              type="button"
+              variant="outline"
+              disabled={deleteMut.isPending}
+              onClick={() => void onDelete()}
+            >
+              حذف پیش‌نویس
+            </Button>
+          ) : null}
+          <Button
+            type="button"
+            variant="primary"
+            disabled={!draftId || isFinalizeBlockedByAuthzChange}
+            onClick={() => {
+              setConfirmOpen(true);
+            }}
+          >
+            نهایی‌سازی
+          </Button>
+        </footer>
+      </form>
+
+      <SensitiveConfirmationDialog
+        open={confirmOpen}
+        onOpenChange={setConfirmOpen}
+        title="تأیید نهایی‌سازی رویداد"
+        consequence={
+          <div className="space-y-2">
+            <p>
+              با تأیید، یک رویداد معتبر در دفتر رویداد ثبت می‌شود و قابل ویرایش
+              یا حذف مستقیم نیست.
+            </p>
+            <p className="text-muted-foreground">
+              تاریخ مؤثر: {effectiveDate || "—"} · نوع: {eventType}
+            </p>
+            {evaluateQuery.isLoading ? (
+              <p role="status">در حال بررسی تعارض‌ها…</p>
+            ) : (
+              <ConflictList conflicts={conflicts} />
+            )}
+          </div>
+        }
+        confirmDisabled={finalizeBlocked || finalizeMut.isPending}
+        blockedReason={
+          isFinalizeBlockedByAuthzChange
+            ? "نهایی‌سازی تا تأیید تغییر دسترسی ممکن نیست."
+            : blocking
+              ? "تعارض مسدودکننده وجود دارد."
+              : !ackComplete
+                ? "تأیید هشدارها الزامی است."
+                : isGoldCtaBlocked
+                  ? "وضعیت کهنه یا بازمحاسبه مانع نهایی‌سازی است."
+                  : undefined
+        }
+        busy={finalizeMut.isPending}
+        onConfirm={onFinalizeConfirm}
+      />
+    </section>
+  );
+}
diff --git a/apps/web/components/personnel/sensitive-confirmation-dialog.tsx b/apps/web/components/personnel/sensitive-confirmation-dialog.tsx
new file mode 100644
index 0000000..db0c436
--- /dev/null
+++ b/apps/web/components/personnel/sensitive-confirmation-dialog.tsx
@@ -0,0 +1,144 @@
+"use client";
+
+import * as React from "react";
+
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { cn } from "@/lib/utils";
+
+/**
+ * Sensitive confirmation dialog (UX-DR14) — Story 4.2 finalize gate.
+ * Focus moves into dialog; Escape returns to trigger; blocked when confirmDisabled.
+ */
+export function SensitiveConfirmationDialog({
+  open,
+  onOpenChange,
+  title,
+  consequence,
+  confirmLabel = "تأیید نهایی‌سازی",
+  cancelLabel = "انصراف",
+  confirmDisabled = false,
+  blockedReason,
+  onConfirm,
+  busy = false,
+}: {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  title: string;
+  consequence: React.ReactNode;
+  confirmLabel?: string;
+  cancelLabel?: string;
+  /** Block confirm when conflicts blocking / authz stale / recalc. */
+  confirmDisabled?: boolean;
+  blockedReason?: string;
+  onConfirm: () => void | Promise<void>;
+  busy?: boolean;
+}) {
+  const titleId = React.useId();
+  const descId = React.useId();
+
+  React.useEffect(() => {
+    if (open) {
+      const t = window.setTimeout(() => {
+        const btn = document.querySelector<HTMLButtonElement>(
+          '[data-confirm-primary="true"]',
+        );
+        btn?.focus();
+      }, 0);
+      return () => window.clearTimeout(t);
+    }
+  }, [open]);
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent
+        className="sm:max-w-2xl"
+        aria-labelledby={titleId}
+        aria-describedby={descId}
+        onEscapeKeyDown={() => onOpenChange(false)}
+      >
+        <DialogHeader>
+          <DialogTitle id={titleId}>{title}</DialogTitle>
+          <DialogDescription id={descId} className="sr-only">
+            تأیید عملیات حساس
+          </DialogDescription>
+        </DialogHeader>
+
+        <div className="space-y-3 text-sm text-foreground" role="region" aria-label="پیامد">
+          {consequence}
+          {blockedReason ? (
+            <p role="alert" className="text-destructive">
+              {blockedReason}
+            </p>
+          ) : null}
+        </div>
+
+        <DialogFooter className="gap-2 sm:justify-start">
+          <Button
+            type="button"
+            variant="ghost"
+            disabled={busy}
+            onClick={() => onOpenChange(false)}
+          >
+            {cancelLabel}
+          </Button>
+          <Button
+            type="button"
+            variant="primary"
+            data-confirm-primary="true"
+            disabled={busy || confirmDisabled}
+            aria-disabled={busy || confirmDisabled}
+            onClick={() => {
+              void onConfirm();
+            }}
+          >
+            {confirmLabel}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
+
+export function ConflictList({
+  conflicts,
+}: {
+  conflicts: Array<{
+    code: string;
+    severity: "blocking" | "warning";
+    messageFa: string;
+  }>;
+}) {
+  if (conflicts.length === 0) return null;
+  return (
+    <ul
+      className="space-y-2"
+      role="list"
+      aria-label="فهرست تعارض‌ها"
+    >
+      {conflicts.map((c) => (
+        <li
+          key={c.code}
+          className={cn(
+            "rounded-md border px-3 py-2 text-sm",
+            c.severity === "blocking"
+              ? "border-destructive/40 text-destructive"
+              : "border-border text-foreground",
+          )}
+        >
+          <span className="sr-only">
+            {c.severity === "blocking" ? "مسدودکننده: " : "هشدار: "}
+          </span>
+          <span aria-live="polite">{c.messageFa}</span>
+        </li>
+      ))}
+    </ul>
+  );
+}
diff --git a/apps/web/src/server/personnel-event.ts b/apps/web/src/server/personnel-event.ts
new file mode 100644
index 0000000..037e0c0
--- /dev/null
+++ b/apps/web/src/server/personnel-event.ts
@@ -0,0 +1,255 @@
+/**
+ * Personnel Event Draft / finalize router (Story 4.2 / FR-15 / FR-19).
+ * Coarse role unlocks nav only — mutations require PermissionSet bindings.
+ */
+import { createPgPool, type Pool } from "@divan/db";
+import {
+  PERSONNEL_EVENT_DATA_CATEGORY,
+  PERSONNEL_EVENT_DRAFT_PERMISSION,
+  PERSONNEL_EVENT_FINALIZE_PERMISSION,
+  PersonnelEventError,
+  assertActorHasPersonnelEventDraft,
+  assertActorHasPersonnelEventFinalize,
+  createDraft,
+  deleteDraft,
+  evaluateDraftForFinalize,
+  finalizeDraft,
+  getDraft,
+  listOpenDraftsForPerson,
+  updateDraft,
+} from "@divan/person-employment";
+import { TRPCError } from "@trpc/server";
+import { z } from "zod";
+
+import { createTRPCRouter, governedProcedure } from "./trpc";
+
+const draftMeta = {
+  permission: PERSONNEL_EVENT_DRAFT_PERMISSION,
+  dataCategory: PERSONNEL_EVENT_DATA_CATEGORY,
+  action: "write" as const,
+  organizationalScope: "org:selfcheck",
+  sensitive: false as const,
+};
+
+const draftReadMeta = {
+  permission: PERSONNEL_EVENT_DRAFT_PERMISSION,
+  dataCategory: PERSONNEL_EVENT_DATA_CATEGORY,
+  action: "read" as const,
+  organizationalScope: "org:selfcheck",
+  sensitive: false as const,
+};
+
+const finalizeMeta = {
+  permission: PERSONNEL_EVENT_FINALIZE_PERMISSION,
+  dataCategory: PERSONNEL_EVENT_DATA_CATEGORY,
+  action: "write" as const,
+  organizationalScope: "org:selfcheck",
+  sensitive: false as const,
+};
+
+let finalizePool: Pool | null = null;
+
+function getFinalizePool(): Pool {
+  if (finalizePool) return finalizePool;
+  const url = process.env.DATABASE_URL?.trim();
+  if (!url) {
+    throw new TRPCError({
+      code: "INTERNAL_SERVER_ERROR",
+      message: "پیکربندی پایگاه‌داده در دسترس نیست.",
+    });
+  }
+  finalizePool = createPgPool(url);
+  return finalizePool;
+}
+
+function mapPersonnelEventError(err: unknown): never {
+  if (err instanceof PersonnelEventError) {
+    if (err.code === "DRAFT_NOT_FOUND" || err.code === "PERSON_NOT_FOUND") {
+      throw new TRPCError({
+        code: "NOT_FOUND",
+        message: err.messageFa,
+        cause: err,
+      });
+    }
+    if (
+      err.code === "DRAFT_VERSION_CONFLICT" ||
+      err.code === "FINALIZE_IDEMPOTENCY_CONFLICT" ||
+      err.code === "DRAFT_ALREADY_FINALIZED"
+    ) {
+      throw new TRPCError({
+        code: "CONFLICT",
+        message: err.messageFa,
+        cause: err,
+      });
+    }
+    if (err.code === "PERMISSION_DENIED") {
+      throw new TRPCError({
+        code: "FORBIDDEN",
+        message: err.messageFa,
+        cause: err,
+      });
+    }
+    throw new TRPCError({
+      code: "BAD_REQUEST",
+      message: err.messageFa,
+      cause: err,
+    });
+  }
+  throw err;
+}
+
+const payloadSchema = z.record(z.string(), z.unknown()).optional();
+
+export const personnelEventRouter = createTRPCRouter({
+  draftCreate: governedProcedure
+    .meta({ ...draftMeta, operation: "personnel_event.draft.create" })
+    .input(
+      z.object({
+        personId: z.string().min(1),
+        employmentId: z.string().optional().nullable(),
+        eventType: z.string().min(1),
+        effectiveDate: z.string().min(1),
+        payload: payloadSchema,
+        idempotencyKey: z.string().optional().nullable(),
+      }),
+    )
+    .mutation(async ({ ctx, input }) => {
+      try {
+        await assertActorHasPersonnelEventDraft(ctx.session.accountId);
+        return await createDraft(input, { accountId: ctx.session.accountId });
+      } catch (err) {
+        mapPersonnelEventError(err);
+      }
+    }),
+
+  draftUpdate: governedProcedure
+    .meta({ ...draftMeta, operation: "personnel_event.draft.update" })
+    .input(
+      z.object({
+        draftId: z.string().min(1),
+        expectedVersion: z.number().int().positive(),
+        employmentId: z.string().optional().nullable(),
+        eventType: z.string().optional(),
+        effectiveDate: z.string().optional(),
+        payload: payloadSchema,
+      }),
+    )
+    .mutation(async ({ ctx, input }) => {
+      try {
+        await assertActorHasPersonnelEventDraft(ctx.session.accountId);
+        return await updateDraft(input, { accountId: ctx.session.accountId });
+      } catch (err) {
+        mapPersonnelEventError(err);
+      }
+    }),
+
+  draftDelete: governedProcedure
+    .meta({ ...draftMeta, operation: "personnel_event.draft.delete" })
+    .input(
+      z.object({
+        draftId: z.string().min(1),
+        expectedVersion: z.number().int().positive(),
+      }),
+    )
+    .mutation(async ({ ctx, input }) => {
+      try {
+        await assertActorHasPersonnelEventDraft(ctx.session.accountId);
+        return await deleteDraft(
+          input.draftId,
+          input.expectedVersion,
+          { accountId: ctx.session.accountId },
+        );
+      } catch (err) {
+        mapPersonnelEventError(err);
+      }
+    }),
+
+  draftGet: governedProcedure
+    .meta({ ...draftReadMeta, operation: "personnel_event.draft.get" })
+    .input(z.object({ draftId: z.string().min(1) }))
+    .query(async ({ ctx, input }) => {
+      try {
+        await assertActorHasPersonnelEventDraft(ctx.session.accountId);
+        return await getDraft(input.draftId);
+      } catch (err) {
+        mapPersonnelEventError(err);
+      }
+    }),
+
+  draftListOpen: governedProcedure
+    .meta({ ...draftReadMeta, operation: "personnel_event.draft.list_open" })
+    .input(z.object({ personId: z.string().min(1) }))
+    .query(async ({ ctx, input }) => {
+      try {
+        await assertActorHasPersonnelEventDraft(ctx.session.accountId);
+        return await listOpenDraftsForPerson(input.personId);
+      } catch (err) {
+        mapPersonnelEventError(err);
+      }
+    }),
+
+  evaluate: governedProcedure
+    .meta({ ...finalizeMeta, operation: "personnel_event.evaluate" })
+    .input(z.object({ draftId: z.string().min(1) }))
+    .query(async ({ ctx, input }) => {
+      try {
+        await assertActorHasPersonnelEventFinalize(ctx.session.accountId);
+        return await evaluateDraftForFinalize(
+          input.draftId,
+          ctx.session.accountId,
+          { correlationId: ctx.correlationId },
+        );
+      } catch (err) {
+        mapPersonnelEventError(err);
+      }
+    }),
+
+  finalize: governedProcedure
+    .meta({ ...finalizeMeta, operation: "personnel_event.finalize" })
+    .input(
+      z.object({
+        draftId: z.string().min(1),
+        expectedVersion: z.number().int().positive().optional(),
+        idempotencyKey: z.string().optional(),
+        acknowledgement: z
+          .object({
+            warningCodes: z.array(z.string()),
+            acknowledgedAt: z.string().optional(),
+          })
+          .optional(),
+        override: z
+          .object({
+            reason: z.string().min(1),
+            approvedByAccountId: z.string().min(1),
+          })
+          .optional(),
+        actorMayOverride: z.boolean().optional(),
+      }),
+    )
+    .mutation(async ({ ctx, input }) => {
+      try {
+        await assertActorHasPersonnelEventFinalize(ctx.session.accountId);
+        const result = await finalizeDraft(
+          {
+            draftId: input.draftId,
+            actorId: ctx.session.accountId,
+            correlationId: ctx.correlationId,
+            expectedVersion: input.expectedVersion,
+            idempotencyKey: input.idempotencyKey,
+            acknowledgement: input.acknowledgement,
+            override: input.override,
+            actorMayOverride:
+              input.actorMayOverride === true ||
+              ctx.session.coarseRole === "hr_admin",
+          },
+          getFinalizePool(),
+        );
+        if (result.outcome === "rejected") {
+          throw new PersonnelEventError(result.code, result.messageFa);
+        }
+        return result;
+      } catch (err) {
+        mapPersonnelEventError(err);
+      }
+    }),
+});
