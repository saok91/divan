+    update: {
+      labelFa: SEED_PERSONNEL_EVENT.roleLabelFa,
+      permissionSetId: permissionSet.id,
+    },
+  });
+
+  for (const username of ["hr.admin", "hr.operator"] as const) {
+    const account = await db.internalAccount.findUnique({
+      where: { username },
