+            >
+              {query.data.plannedMembershipDeltas.map((d) => (
+                <li key={d.eventId} className="text-sm text-muted-foreground">
+                  <span>╪¿╪▒┘å╪º┘à┘çΓÇî╪▒█î╪▓█îΓÇî╪┤╪»┘ç </span>
+                  <span dir="ltr" className="font-mono">
+                    {d.eventType}
