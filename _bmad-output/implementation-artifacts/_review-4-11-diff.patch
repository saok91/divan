+}

diff --git a/packages/modules/headcount/src/historical-headcount.ts b/packages/modules/headcount/src/historical-headcount.ts
new file mode 100644
index 0000000..5eb0038
--- /dev/null
+++ b/packages/modules/headcount/src/historical-headcount.ts
@@ -0,0 +1,375 @@
+/**
+ * Historical headcount quantity reconstruction (Story 4.11 / FR-27).
+ * Event-linked ledger read ΓÇö NOT live free_units/reserved_units for asOf < today.
+ * `readHeadcountCapacityPanel` remains live/finalize-only (UX-DR13).
+ */
+
+import {
+  getBusinessEventById,
+  listChainLinksForEvents,
+  type BusinessEventRecord,
+  type BusinessEventStatus,
+  type PgQueryable,
+} from "@divan/event-store";
+import { parseDateOnly } from "@divan/temporal-engine";
+
+import type { Pool, PoolClient } from "@divan/db";
+
+export const MSG_HEADCOUNT_ASOF_INVALID_FA =
+  "╪¬╪º╪▒█î╪« ┘à╪¿┘å╪º ┘å╪º┘à╪╣╪¬╪¿╪▒ ╪º╪│╪¬╪¢ ╪¿╪º╪▓╪│╪º╪▓█î ╪╕╪▒┘ü█î╪¬ ╪º╪▒╪º╪ª┘ç ┘å┘à█îΓÇî╪┤┘ê╪».";
+
+export const MSG_HEADCOUNT_LEDGER_AMBIGUOUS_FA =
+  "┘╛█î┘ê┘å╪» ╪»┘ü╪¬╪▒ ╪╕╪▒┘ü█î╪¬ ╪¿╪º ╪▒┘ê█î╪»╪º╪» ┘à╪¿┘ç┘à █î╪º ┘å╪º┘à┘ê╪¼┘ê╪» ╪º╪│╪¬╪¢ ╪¿╪º╪▓╪│╪º╪▓█î ╪¬╪º╪▒█î╪«█î ┘à╪│╪»┘ê╪» ╪º╪│╪¬.";
+
+export class HeadcountLedgerError extends Error {
+  readonly code: "VALIDATION" | "LEDGER_AMBIGUOUS";
+  readonly messageFa: string;
+
+  constructor(
+    code: "VALIDATION" | "LEDGER_AMBIGUOUS",
+    messageFa: string,
+    message?: string,
+  ) {
+    super(message ?? messageFa);
+    this.name = "HeadcountLedgerError";
+    this.code = code;
+    this.messageFa = messageFa;
+  }
+}
+
+type Queryable = Pick<Pool, "query"> | Pick<PoolClient, "query">;
+
+async function query<T extends Record<string, unknown>>(
+  db: Queryable,
+  sql: string,
+  params: unknown[] = [],
+): Promise<T[]> {
+  const r = await db.query(sql, params);
+  return r.rows as T[];
+}
+
+/**
+ * Lightweight evaluation-by-date (mirrors person-employment without import cycle).
+ */
+function evaluationStatusAsOf(
+  event: Pick<BusinessEventRecord, "status" | "effectiveDate">,
+  asOfDate: string,
+): BusinessEventStatus {
+  if (event.status === "Draft") return "Draft";
+  if (event.status === "Cancelled" || event.status === "Reversed") {
+    return event.status;
+  }
+  if (event.status === "Scheduled" && event.effectiveDate <= asOfDate) {
+    return "Effective";
+  }
+  return event.status;
+}
+
+function resolveLifecycleStatus(
+  event: BusinessEventRecord,
+  links: {
+    cancellations: BusinessEventRecord[];
+    reversals: BusinessEventRecord[];
+  },
+  asOfDate: string,
+): BusinessEventStatus {
+  if (links.cancellations.length > 0) return "Cancelled";
+  if (links.reversals.length > 0) return "Reversed";
+  return evaluationStatusAsOf(event, asOfDate);
+}
+
+export type ReconstructHeadcountQuantitiesInput = {
+  asOf: string;
+  teamId?: string;
+  slotId?: string;
+};
+
+export type HeadcountSlotQuantities = {
+  slotId: string;
+  teamId: string;
+  jobTitleId: string | null;
+  ladderId: string | null;
+  gradeId: string | null;
+  /** MVP Approval stand-in: live used + reserved + free ceiling. */
+  approved: number;
+  used: number;
+  reserved: number;
+  free: number;
+};
+
+export type ReconstructHeadcountQuantitiesResult = {
+  asOf: string;
+  slots: HeadcountSlotQuantities[];
+  aggregate: {
+    approved: number;
+    used: number;
+    reserved: number;
+    free: number;
+  };
+};
+
+/** Compare helper ΓÇö ignores nothing wall-clock; slots sorted by slotId. */
+export function headcountQuantitiesFactsForCompare(
+  result: ReconstructHeadcountQuantitiesResult,
+): unknown {
+  return {
+    asOf: result.asOf,
+    slots: [...result.slots]
+      .map((s) => ({
+        slotId: s.slotId,
+        teamId: s.teamId,
+        jobTitleId: s.jobTitleId,
+        ladderId: s.ladderId,
+        gradeId: s.gradeId,
+        approved: s.approved,
+        used: s.used,
+        reserved: s.reserved,
+        free: s.free,
+      }))
+      .sort((a, b) => a.slotId.localeCompare(b.slotId)),
+    aggregate: { ...result.aggregate },
+  };
+}
+
+type SlotRow = {
+  id: string;
+  team_id: string;
+  job_title_id: string | null;
+  ladder_id: string | null;
+  grade_id: string | null;
+  start_date: Date | string;
+  end_date_exclusive: Date | string | null;
+  free_units: number;
+  reserved_units: number;
+};
+
+type ConsumptionRow = {
+  id: string;
+  slot_id: string;
+  event_id: string;
+  person_id: string;
+  release_event_id: string | null;
+};
+
+type ReservationRow = {
+  id: string;
+  slot_id: string;
+  event_id: string;
+  person_id: string;
+  status: string;
+};
+
+/**
+ * Reconstruct approved/used/reserved/free per in-scope slot at `asOf`.
+ *
+ * - used/reserved: event-linked ledger + Effective/lifecycle (not live counters)
+ * - approved: MVP stand-in from current slot counters (until Story 4.12 Approval)
+ * - free: approved ΓêÆ used ΓêÆ reserved (catalogue identity; MVP ΓëÑ 0)
+ *
+ * Do **not** use this as a silent wrapper around `readHeadcountCapacityPanel`
+ * for historical dates ΓÇö that panel reads live counters only.
+ */
+export async function reconstructHeadcountQuantitiesAsOf(
+  db: Queryable,
+  input: ReconstructHeadcountQuantitiesInput,
+): Promise<ReconstructHeadcountQuantitiesResult> {
+  const parsed = parseDateOnly(input.asOf);
+  if (!parsed.ok) {
+    throw new HeadcountLedgerError(
+      "VALIDATION",
+      MSG_HEADCOUNT_ASOF_INVALID_FA,
+      parsed.reason,
+    );
+  }
+  const asOf = parsed.value;
+  const eventDb = db as PgQueryable;
+
+  const params: unknown[] = [asOf];
+  let sql = `
+    SELECT id, team_id, job_title_id, ladder_id, grade_id,
+           start_date, end_date_exclusive, free_units, reserved_units
+    FROM headcount_capacity_slot
+    WHERE start_date <= $1::date
+      AND (end_date_exclusive IS NULL OR end_date_exclusive > $1::date)`;
+  if (input.slotId?.trim()) {
+    params.push(input.slotId.trim());
+    sql += ` AND id = $${params.length}::uuid`;
+  }
+  if (input.teamId?.trim()) {
+    params.push(input.teamId.trim());
+    sql += ` AND team_id = $${params.length}::uuid`;
+  }
+  sql += ` ORDER BY team_id ASC, start_date ASC, id ASC`;
+
+  const slots = await query<SlotRow>(db, sql, params);
+  if (slots.length === 0) {
+    return {
+      asOf,
+      slots: [],
+      aggregate: { approved: 0, used: 0, reserved: 0, free: 0 },
+    };
+  }
+
+  const slotIds = slots.map((s) => s.id);
+  const consumptions = await query<ConsumptionRow>(
+    db,
+    `SELECT id, slot_id, event_id, person_id, release_event_id
+     FROM headcount_capacity_consumption
+     WHERE slot_id = ANY($1::uuid[])`,
+    [slotIds],
+  );
+  const reservations = await query<ReservationRow>(
+    db,
+    `SELECT id, slot_id, event_id, person_id, status
+     FROM headcount_capacity_reservation
+     WHERE slot_id = ANY($1::uuid[])`,
+    [slotIds],
+  );
+
+  const eventIds = new Set<string>();
+  for (const c of consumptions) {
+    eventIds.add(c.event_id);
+    if (c.release_event_id) eventIds.add(c.release_event_id);
+  }
+  for (const r of reservations) {
+    eventIds.add(r.event_id);
+  }
+
+  const eventIdList = [...eventIds];
+  const eventsById = new Map<string, BusinessEventRecord>();
+  for (const id of eventIdList) {
+    const ev = await getBusinessEventById(eventDb, id);
+    if (!ev) {
+      throw new HeadcountLedgerError(
+        "LEDGER_AMBIGUOUS",
+        MSG_HEADCOUNT_LEDGER_AMBIGUOUS_FA,
+        `missing_event:${id}`,
+      );
+    }
+    eventsById.set(id, ev);
+  }
+  const chainMap = await listChainLinksForEvents(eventDb, eventIdList);
+
+  const usedBySlot = new Map<string, number>();
+  const reservedBySlot = new Map<string, number>();
+  for (const id of slotIds) {
+    usedBySlot.set(id, 0);
+    reservedBySlot.set(id, 0);
+  }
+
+  for (const c of consumptions) {
+    const consumeEv = eventsById.get(c.event_id)!;
+    const consumeLinks = chainMap.get(c.event_id) ?? {
+      cancellations: [],
+      reversals: [],
+      corrections: [],
+    };
+    const consumeStatus = resolveLifecycleStatus(
+      consumeEv,
+      consumeLinks,
+      asOf,
+    );
+    if (
+      consumeStatus === "Cancelled" ||
+      consumeStatus === "Reversed" ||
+      consumeStatus === "Draft"
+    ) {
+      continue;
+    }
+    // Used only once the consume event is Effective at asOf.
+    if (consumeStatus !== "Effective") continue;
+
+    if (c.release_event_id) {
+      const releaseEv = eventsById.get(c.release_event_id)!;
+      const releaseLinks = chainMap.get(c.release_event_id) ?? {
+        cancellations: [],
+        reversals: [],
+        corrections: [],
+      };
+      const releaseStatus = resolveLifecycleStatus(
+        releaseEv,
+        releaseLinks,
+        asOf,
+      );
+      if (releaseStatus === "Effective") {
+        continue; // released as of asOf
+      }
+      // Cancelled/Reversed/Scheduled release ΓåÆ still used at asOf
+    }
+
+    usedBySlot.set(c.slot_id, (usedBySlot.get(c.slot_id) ?? 0) + 1);
+  }
+
+  for (const r of reservations) {
+    const ev = eventsById.get(r.event_id)!;
+    const links = chainMap.get(r.event_id) ?? {
+      cancellations: [],
+      reversals: [],
+      corrections: [],
+    };
+    const status = resolveLifecycleStatus(ev, links, asOf);
+    // Active reservation at asOf: Finalized event still Scheduled (pre-effect).
+    if (status === "Scheduled") {
+      reservedBySlot.set(r.slot_id, (reservedBySlot.get(r.slot_id) ?? 0) + 1);
+    }
+  }
+
+  // Live used for approved stand-in (current unreased consumptions).
+  const liveUsedRows = await query<{ slot_id: string; c: string }>(
+    db,
+    `SELECT slot_id, COUNT(*)::text AS c
+     FROM headcount_capacity_consumption
+     WHERE slot_id = ANY($1::uuid[]) AND release_event_id IS NULL
+     GROUP BY slot_id`,
+    [slotIds],
+  );
+  const liveUsedBySlot = new Map<string, number>();
+  for (const row of liveUsedRows) {
+    liveUsedBySlot.set(row.slot_id, Number(row.c));
+  }
+
+  const resultSlots: HeadcountSlotQuantities[] = [];
+  let aggApproved = 0;
+  let aggUsed = 0;
+  let aggReserved = 0;
+  let aggFree = 0;
+
+  for (const slot of slots) {
+    const liveUsed = liveUsedBySlot.get(slot.id) ?? 0;
+    const liveReserved = Number(slot.reserved_units);
+    const liveFree = Number(slot.free_units);
+    // Approval stand-in until 4.12 ΓÇö conserved live ceiling for the slot.
+    const approved = liveUsed + liveReserved + liveFree;
+    const used = usedBySlot.get(slot.id) ?? 0;
+    const reserved = reservedBySlot.get(slot.id) ?? 0;
+    let free = approved - used - reserved;
+    if (free < 0) free = 0;
+
+    resultSlots.push({
+      slotId: slot.id,
+      teamId: slot.team_id,
+      jobTitleId: slot.job_title_id,
+      ladderId: slot.ladder_id,
+      gradeId: slot.grade_id,
+      approved,
+      used,
+      reserved,
+      free,
+    });
+    aggApproved += approved;
+    aggUsed += used;
+    aggReserved += reserved;
+    aggFree += free;
+  }
+
+  return {
+    asOf,
+    slots: resultSlots,
+    aggregate: {
+      approved: aggApproved,
+      used: aggUsed,
+      reserved: aggReserved,
+      free: aggFree,
+    },
+  };
+}

diff --git a/packages/modules/person-employment/src/historical-org-headcount.selfcheck.ts b/packages/modules/person-employment/src/historical-org-headcount.selfcheck.ts
new file mode 100644
index 0000000..efa06b6
--- /dev/null
+++ b/packages/modules/person-employment/src/historical-org-headcount.selfcheck.ts
@@ -0,0 +1,497 @@
+/**
+ * Historical org + headcount reconstruction selfcheck (Story 4.11 / FR-27).
+ * Run: pnpm --filter @divan/person-employment selfcheck:historical-org-headcount
+ * Requires DATABASE_URL, migrated schema, seeded accounts + org/job fixtures.
+ */
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { config as loadEnv } from "dotenv";
+
+import { createPgPool } from "@divan/db";
+import {
+  ensureHeadcountCapacitySchema,
+  headcountQuantitiesFactsForCompare,
+  readHeadcountCapacityPanel,
+  reconstructHeadcountQuantitiesAsOf,
+  seedCapacitySlot,
+} from "@divan/headcount";
+import { todayDateOnlyTehran } from "@divan/temporal-engine";
+
+import {
+  BASELINE_BOUNDARY_ENV,
+  cancelPersonnelEvent,
+  clearRecalculationStatus,
+  createDraft,
+  createOrgUnit,
+  createPerson,
+  finalizeDraft,
+  getBaselineBoundaryDate,
+  getHistoricalOrgHeadcountState,
+  getPersonDb,
+  historicalOrgHeadcountFactsForCompare,
+  listEmploymentsForPerson,
+  resetProjectionRefreshHook,
+  seedPersonnelEventPermissionFixtures,
+  seedPrimaryAssignmentFixtures,
+  SEED_EMPLOYMENT_LIFECYCLE,
+  SEED_JOB_REFERENCES,
+  SEED_ORGANIZATION_HIERARCHY,
+} from "./index";
+
+const rootEnv = resolve(
+  fileURLToPath(new URL(".", import.meta.url)),
+  "../../../../.env",
+);
+loadEnv({ path: rootEnv });
+
+function addDays(dateOnly: string, days: number): string {
+  const [ys, ms, ds] = dateOnly.split("-");
+  const dt = new Date(Date.UTC(Number(ys), Number(ms) - 1, Number(ds)));
+  dt.setUTCDate(dt.getUTCDate() + days);
+  const y = dt.getUTCFullYear();
+  const m = String(dt.getUTCMonth() + 1).padStart(2, "0");
+  const d = String(dt.getUTCDate()).padStart(2, "0");
+  return `${y}-${m}-${d}`;
+}
+
+async function resolveJobRefs(db: ReturnType<typeof getPersonDb>) {
+  const role = await db.organizationalRole.findUniqueOrThrow({
+    where: { code: SEED_JOB_REFERENCES.role.code },
+  });
+  const title = await db.jobTitle.findUniqueOrThrow({
+    where: { code: SEED_JOB_REFERENCES.jobTitle.code },
+  });
+  const ladder = await db.ladder.findUniqueOrThrow({
+    where: { code: SEED_JOB_REFERENCES.ladder.code },
+  });
+  const grade = await db.grade.findUniqueOrThrow({
+    where: {
+      ladderId_code: {
+        ladderId: ladder.id,
+        code: SEED_JOB_REFERENCES.gradeLow.code,
+      },
+    },
+  });
+  const seniority = await db.seniority.findUniqueOrThrow({
+    where: { code: SEED_JOB_REFERENCES.seniority.code },
+  });
+  return {
+    organizationalRoleId: role.id,
+    jobTitleId: title.id,
+    ladderId: ladder.id,
+    gradeId: grade.id,
+    seniorityId: seniority.id,
+  };
+}
+
+async function main() {
+  const url = process.env.DATABASE_URL?.trim();
+  assert.ok(url, "DATABASE_URL required");
+
+  const db = getPersonDb();
+  const pool = createPgPool(url);
+  const prevBaseline = process.env[BASELINE_BOUNDARY_ENV];
+
+  try {
+    resetProjectionRefreshHook();
+    await seedPrimaryAssignmentFixtures(db);
+    await seedPersonnelEventPermissionFixtures(db);
+    await ensureHeadcountCapacitySchema(pool);
+
+    const jobRefs = await resolveJobRefs(db);
+    const dept = await db.organizationalUnit.findUniqueOrThrow({
+      where: { code: SEED_ORGANIZATION_HIERARCHY.department.code },
+    });
+
+    const operator =
+      (await db.internalAccount.findUnique({ where: { username: "hr.operator" } }))
+        ?.id ?? "selfcheck-operator";
+    const admin =
+      (await db.internalAccount.findUnique({ where: { username: "hr.admin" } }))
+        ?.id ?? "selfcheck-admin";
+
+    const suffix = randomUUID().slice(0, 8);
+    const today = todayDateOnlyTehran();
+    const startEd = addDays(today, -10);
+    const xferEd = addDays(today, -5);
+    const histAfterXfer = addDays(today, -2);
+    const histBeforeXfer = addDays(today, -7);
+    const future = addDays(today, 30);
+    const futureXferEd = addDays(today, 15);
+
+    const sourceTeamScoped = await createOrgUnit(
+      {
+        code: `TEAM-HOH-SRC-${suffix}`,
+        nameFa: "╪¬█î┘à ┘à╪¿╪»╪ú ╪┤┘à╪º╪▒╪┤ ╪¬╪º╪▒█î╪«█î",
+        unitType: "TEAM",
+        parentId: dept.id,
+        startDate: "2020-01-01",
+      },
+      db,
+    );
+    const sourceSlotScoped = await seedCapacitySlot(pool, {
+      id: randomUUID(),
+      teamId: sourceTeamScoped.id,
+      jobTitleId: jobRefs.jobTitleId,
+      ladderId: jobRefs.ladderId,
+      gradeId: jobRefs.gradeId,
+      startDate: "2020-01-01",
+      freeUnits: 5,
+      label: `hoh-src-${suffix}`,
+    });
+
+    const destTeam = await createOrgUnit(
+      {
+        code: `TEAM-HOH-${suffix}`,
+        nameFa: "╪¬█î┘à ┘à┘é╪╡╪» ╪┤┘à╪º╪▒╪┤ ╪¬╪º╪▒█î╪«█î",
+        unitType: "TEAM",
+        parentId: dept.id,
+        startDate: "2020-01-01",
+      },
+      db,
+    );
+    const destSlotId = await seedCapacitySlot(pool, {
+      id: randomUUID(),
+      teamId: destTeam.id,
+      jobTitleId: jobRefs.jobTitleId,
+      ladderId: jobRefs.ladderId,
+      gradeId: jobRefs.gradeId,
+      startDate: "2020-01-01",
+      freeUnits: 5,
+      label: `hoh-dest-${suffix}`,
+    });
+
+    const person = await createPerson(
+      {
+        personnelCode: `41${suffix.slice(0, 6)}`,
+        givenName: "╪┤┘à╪º╪▒╪┤",
+        familyName: "╪¬╪º╪▒█î╪«█î",
+        mobilePhone: "09124111001",
+      },
+      { accountId: operator, correlationId: `sc-hoh-${suffix}` },
+      db,
+    );
+
+    const startDraft = await createDraft(
+      {
+        personId: person.id,
+        eventType: "EmploymentStarted",
+        effectiveDate: startEd,
+        payload: {
+          collaborationType: SEED_EMPLOYMENT_LIFECYCLE.collaborationActive,
+          teamId: sourceTeamScoped.id,
+          ...jobRefs,
+          capacitySlotId: sourceSlotScoped,
+        },
+      },
+      { accountId: operator },
+      db,
+    );
+    const startFin = await finalizeDraft(
+      {
+        draftId: startDraft.id,
+        actorId: operator,
+        expectedVersion: startDraft.version,
+        idempotencyKey: `hoh-start-${suffix}`,
+      },
+      pool,
+      db,
+    );
+    assert.equal(startFin.outcome, "finalized");
+    await clearRecalculationStatus(pool, person.id);
+
+    const emps = await listEmploymentsForPerson(person.id, db);
+    assert.equal(emps.length, 1);
+    const employmentId = emps[0]!.id;
+
+    // --- Oracle: invalid asOf rejected ---
+    await assert.rejects(
+      () =>
+        getHistoricalOrgHeadcountState(
+          { asOf: "not-a-date", teamId: sourceTeamScoped.id },
+          { eventDb: pool },
+        ),
+      (err: unknown) =>
+        err instanceof Error &&
+        ("code" in err
+          ? (err as { code: string }).code === "VALIDATION"
+          : true),
+    );
+
+    // --- After Start, before Transfer: source membership 1; source used ΓëÑ 1 ---
+    const beforeXfer = await getHistoricalOrgHeadcountState(
+      { asOf: histBeforeXfer, teamId: sourceTeamScoped.id },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(beforeXfer.ok, true);
+    if (beforeXfer.ok) {
+      assert.equal(beforeXfer.viewSemantics, "historical");
+      assert.equal(beforeXfer.aggregate.teamMembershipCount, 1);
+      assert.ok(beforeXfer.aggregate.used >= 1);
+      const rollup = beforeXfer.detail.teams.reduce(
+        (s, t) => s + t.teamMembershipCount,
+        0,
+      );
+      assert.equal(rollup, beforeXfer.aggregate.teamMembershipCount);
+    }
+
+    // --- Scheduled Transfer (future effective): source membership unchanged; dest reserved ---
+    const schedDraft = await createDraft(
+      {
+        personId: person.id,
+        employmentId,
+        eventType: "TransferRecorded",
+        effectiveDate: futureXferEd,
+        payload: {
+          teamId: destTeam.id,
+          ...jobRefs,
+          capacitySlotId: destSlotId,
+        },
+      },
+      { accountId: operator },
+      db,
+    );
+    const schedFin = await finalizeDraft(
+      {
+        draftId: schedDraft.id,
+        actorId: operator,
+        expectedVersion: schedDraft.version,
+        idempotencyKey: `hoh-sched-${suffix}`,
+      },
+      pool,
+      db,
+    );
+    assert.equal(schedFin.outcome, "finalized");
+    await clearRecalculationStatus(pool, person.id);
+
+    const afterSchedSource = await getHistoricalOrgHeadcountState(
+      { asOf: today, teamId: sourceTeamScoped.id },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(afterSchedSource.ok, true);
+    if (afterSchedSource.ok) {
+      assert.equal(afterSchedSource.viewSemantics, "current");
+      assert.equal(afterSchedSource.aggregate.teamMembershipCount, 1);
+      assert.ok(afterSchedSource.aggregate.used >= 1);
+    }
+
+    const afterSchedDest = await getHistoricalOrgHeadcountState(
+      { asOf: today, teamId: destTeam.id },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(afterSchedDest.ok, true);
+    if (afterSchedDest.ok) {
+      assert.equal(afterSchedDest.aggregate.teamMembershipCount, 0);
+      assert.ok(
+        afterSchedDest.aggregate.reserved >= 1,
+        "dest reserved ΓëÑ 1 after Scheduled Transfer finalize",
+      );
+    }
+
+    // --- asOf=today ledger Γëí live panel for dest fixture slot ---
+    const ledgerToday = await reconstructHeadcountQuantitiesAsOf(pool, {
+      asOf: today,
+      slotId: destSlotId,
+    });
+    const panelToday = await readHeadcountCapacityPanel(pool, {
+      teamId: destTeam.id,
+      jobTitleId: jobRefs.jobTitleId,
+      ladderId: jobRefs.ladderId,
+      gradeId: jobRefs.gradeId,
+      effectiveDate: today,
+      preferredSlotId: destSlotId,
+    });
+    assert.equal(ledgerToday.slots.length, 1);
+    const destLedger = ledgerToday.slots[0]!;
+    assert.equal(destLedger.used, panelToday.used);
+    assert.equal(destLedger.reserved, panelToday.reserved);
+    assert.equal(destLedger.free, panelToday.free);
+    assert.equal(
+      destLedger.approved,
+      panelToday.used + panelToday.reserved + panelToday.free,
+    );
+
+    // Dual-consumer headcount facts
+    const ledgerTodayB = await reconstructHeadcountQuantitiesAsOf(pool, {
+      asOf: today,
+      slotId: destSlotId,
+    });
+    assert.deepEqual(
+      headcountQuantitiesFactsForCompare(ledgerToday),
+      headcountQuantitiesFactsForCompare(ledgerTodayB),
+    );
+
+    // Cancel scheduled transfer so we can create an Effective past transfer
+    if (schedFin.outcome === "finalized") {
+      await cancelPersonnelEvent(
+        schedFin.eventId,
+        {
+          actorId: admin,
+          reason: "selfcheck replace with past transfer",
+        },
+        pool,
+        db,
+      );
+      await clearRecalculationStatus(pool, person.id);
+    }
+
+    // --- Effective past Transfer: source ΓêÆ1, dest +1; capacity used moved ---
+    const xferDraft = await createDraft(
+      {
+        personId: person.id,
+        employmentId,
+        eventType: "TransferRecorded",
+        effectiveDate: xferEd,
+        payload: {
+          teamId: destTeam.id,
+          ...jobRefs,
+          capacitySlotId: destSlotId,
+        },
+      },
+      { accountId: operator },
+      db,
+    );
+    const xferFin = await finalizeDraft(
+      {
+        draftId: xferDraft.id,
+        actorId: operator,
+        expectedVersion: xferDraft.version,
+        idempotencyKey: `hoh-xfer-${suffix}`,
+      },
+      pool,
+      db,
+    );
+    assert.equal(xferFin.outcome, "finalized");
+    await clearRecalculationStatus(pool, person.id);
+
+    const afterXferSource = await getHistoricalOrgHeadcountState(
+      { asOf: histAfterXfer, teamId: sourceTeamScoped.id },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(afterXferSource.ok, true);
+    if (afterXferSource.ok) {
+      assert.equal(afterXferSource.aggregate.teamMembershipCount, 0);
+    }
+
+    const afterXferDest = await getHistoricalOrgHeadcountState(
+      { asOf: histAfterXfer, teamId: destTeam.id },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(afterXferDest.ok, true);
+    if (afterXferDest.ok) {
+      assert.equal(afterXferDest.aggregate.teamMembershipCount, 1);
+      assert.ok(afterXferDest.aggregate.used >= 1);
+      assert.equal(afterXferDest.aggregate.reserved, 0);
+      // Detail Γëí aggregate
+      const rollup = afterXferDest.detail.teams.reduce(
+        (s, t) => s + t.teamMembershipCount,
+        0,
+      );
+      assert.equal(rollup, afterXferDest.aggregate.teamMembershipCount);
+      assert.deepEqual(
+        afterXferDest.detail.orgUnitCounts,
+        afterXferDest.aggregate.orgUnitCounts,
+      );
+      assert.equal(
+        afterXferDest.detail.headcount.aggregate.used,
+        afterXferDest.aggregate.used,
+      );
+    }
+
+    // Dual-consumer coordinator facts
+    const afterXferDestB = await getHistoricalOrgHeadcountState(
+      { asOf: histAfterXfer, teamId: destTeam.id },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(afterXferDestB.ok, true);
+    if (afterXferDest.ok && afterXferDestB.ok) {
+      assert.deepEqual(
+        historicalOrgHeadcountFactsForCompare(afterXferDest),
+        historicalOrgHeadcountFactsForCompare(afterXferDestB),
+      );
+    }
+
+    // Historical before Effective: still on source
+    const midHist = await getHistoricalOrgHeadcountState(
+      { asOf: histBeforeXfer, teamId: sourceTeamScoped.id },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(midHist.ok, true);
+    if (midHist.ok) {
+      assert.equal(midHist.aggregate.teamMembershipCount, 1);
+    }
+
+    // --- Future asOf planned: facts @ today; no Effective label on planned ---
+    const planned = await getHistoricalOrgHeadcountState(
+      { asOf: future, teamId: destTeam.id },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(planned.ok, true);
+    if (planned.ok) {
+      assert.equal(planned.viewSemantics, "planned");
+      assert.equal(planned.factsAsOf, today);
+      assert.equal(planned.aggregate.teamMembershipCount, 1);
+      for (const d of planned.plannedMembershipDeltas) {
+        assert.equal(d.channel, "planned");
+        assert.notEqual(d.channel, "Effective");
+      }
+    }
+
+    // --- Baseline disclosure limited / unset ---
+    delete process.env[BASELINE_BOUNDARY_ENV];
+    const unsetBoundary = getBaselineBoundaryDate();
+    assert.equal(unsetBoundary, null);
+    const withUnset = await getHistoricalOrgHeadcountState(
+      { asOf: today, teamId: destTeam.id, baselineBoundaryDate: null },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(withUnset.ok, true);
+    if (withUnset.ok) {
+      assert.equal(withUnset.baselineDisclosure.configured, false);
+    }
+
+    const limitedBoundary = addDays(today, -100);
+    const withLimited = await getHistoricalOrgHeadcountState(
+      {
+        asOf: addDays(limitedBoundary, -1),
+        teamId: destTeam.id,
+        baselineBoundaryDate: limitedBoundary,
+      },
+      { personDb: db, eventDb: pool },
+    );
+    assert.equal(withLimited.ok, true);
+    if (withLimited.ok) {
+      assert.equal(withLimited.baselineDisclosure.limited, true);
+      assert.equal(withLimited.baselineDisclosure.configured, true);
+    }
+
+    // Conservation identity per slot
+    if (afterXferDest.ok) {
+      for (const slot of afterXferDest.detail.headcount.slots) {
+        assert.equal(
+          slot.approved,
+          slot.used + slot.reserved + slot.free,
+          `conservation slot=${slot.slotId}`,
+        );
+      }
+    }
+
+    console.log("historical-org-headcount.selfcheck: OK");
+  } finally {
+    if (prevBaseline === undefined) {
+      delete process.env[BASELINE_BOUNDARY_ENV];
+    } else {
+      process.env[BASELINE_BOUNDARY_ENV] = prevBaseline;
+    }
+    await pool.end();
+    await db.$disconnect();
+  }
+}
+
+main().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});

