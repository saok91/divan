{
  "name": "divan",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @divan/web dev",
    "build": "pnpm db:generate && pnpm --filter @divan/web build",
    "lint": "pnpm --filter @divan/web lint && eslint .",
    "db:generate": "pnpm --filter @divan/db generate",
    "db:migrate": "pnpm --filter @divan/db migrate",
    "db:seed": "pnpm --filter @divan/identity-access seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:sql:apply": "pnpm --filter @divan/db sql:apply",
    "selfcheck:audit-envelope": "pnpm --filter @divan/audit-envelope selfcheck",
    "selfcheck:governed": "pnpm --filter @divan/web selfcheck:governed",
    "selfcheck:access-admin": "pnpm --filter @divan/identity-access selfcheck:access-admin",
    "selfcheck:entitlement-lifecycle": "pnpm --filter @divan/identity-access selfcheck:entitlement-lifecycle",
    "selfcheck:break-glass": "pnpm --filter @divan/identity-access selfcheck:break-glass",
    "selfcheck:temporal-authz": "pnpm --filter @divan/identity-access selfcheck:temporal-authz",
    "selfcheck:inference-bulk": "pnpm --filter @divan/audit-envelope selfcheck:inference-bulk",
    "selfcheck:person-identity": "pnpm --filter @divan/person-employment selfcheck:person-identity",
    "selfcheck:employment-lifecycle": "pnpm --filter @divan/person-employment selfcheck:employment-lifecycle",
    "selfcheck:data-dictionary": "pnpm --filter @divan/person-employment selfcheck:data-dictionary",
    "selfcheck:organization-hierarchy": "pnpm --filter @divan/person-employment selfcheck:organization-hierarchy",
    "selfcheck:job-reference": "pnpm --filter @divan/person-employment selfcheck:job-reference",
    "selfcheck:primary-assignment": "pnpm --filter @divan/person-employment selfcheck:primary-assignment",
    "selfcheck:secondary-assignment": "pnpm --filter @divan/person-employment selfcheck:secondary-assignment",
    "selfcheck:management-relationships": "pnpm --filter @divan/person-employment selfcheck:management-relationships",
    "selfcheck:compensation-facts": "pnpm --filter @divan/compensation-facts selfcheck:compensation-facts",
    "selfcheck:dashboard": "pnpm --filter @divan/reporting selfcheck:dashboard && pnpm --filter @divan/web selfcheck:dashboard"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
