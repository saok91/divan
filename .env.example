# Local development PostgreSQL only (17.10+).
# Preferred: pnpm db:up  (root docker-compose.yml)
# Port conflict: POSTGRES_PORT=5433 pnpm db:up  — then match the port below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/divan?schema=public"

# Auth.js — required for sessions. Generate a strong secret for real deploys.
# Example local value only — never reuse in production.
# Next.js also needs these under apps/web/.env (copy from here); next.config loads root .env too.
AUTH_SECRET="dev-only-change-me-divan-auth-secret"

# Production only: set to `true` behind a trusted reverse proxy so Auth.js trusts the Host header.
# Local/dev does not need this (trustHost is enabled when NODE_ENV !== production).
# AUTH_TRUST_HOST="true"

# Identity provider: `seeded` (local/dev/CI) | `ldap` (Story 1.8 — no silent seed fallback).
# Unsupported values fail closed (do not fall back to seeded).
IDENTITY_PROVIDER="seeded"

# Dev seed guard — must be exactly `true` and NODE_ENV must not be production.
ALLOW_DEV_SEED="true"

# Session timeout hooks (seconds) — local/dev defaults only; not AR-IDENTITY production numbers.
# Idle: 8h; Absolute: 24h
AUTH_SESSION_IDLE_TIMEOUT_SECONDS="28800"
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECONDS="86400"

# --- Dev-only seeded credentials (never for production) ---
# Password for all five accounts: DivanDev1!
#   hr.operator      → hr_operator
#   hr.admin         → hr_admin
#   manager          → manager
#   audit.reviewer   → audit_reviewer
#   sys.admin        → system_admin
# Mark inactive for fail-closed tests via setAccountStatus() in @divan/identity-access.
