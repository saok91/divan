+    assert.ok(
+      resolved === "Scheduled" || resolved === "Effective",
+      "display status derived",
+    );
+
+    console.log("personnel-event-lifecycle selfcheck: OK");
+  } finally {
+    resetProjectionRefreshHook();
+    await pool.end();
+  }
+}
+
+main().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});
